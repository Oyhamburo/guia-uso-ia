---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LevelHero from "../../components/LevelHero.astro";
import FieldNote from "../../components/FieldNote.astro";
import TrailSummary from "../../components/TrailSummary.astro";
import { initialLevels } from "../../data/part1";

const level = initialLevels[1];
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const href = (path: string) => `${base}${path.replace(/^\//, "")}`;
---

<BaseLayout title={`${level.title} · Expedición IA`} description={level.promise}>
  <main id="contenido" class="level-page">
    <LevelHero
      level="Nivel 2"
      eyebrow={level.kicker}
      title={level.title}
      intro={level.promise}
      dino={level.dino}
      tone={level.color}
    />

    <section class="visual-block prompt" aria-labelledby="prompt-title">
      <div class="block-heading">
        <span class="step">01</span>
        <div><p>El punto de partida</p><h2 id="prompt-title">¿Qué es un prompt?</h2></div>
      </div>
      <p class="lead">Es lo que le das a la IA para orientar su respuesta.</p>
      <div class="prompt-flow" aria-label="Un prompt viaja desde una persona hacia la IA y produce un primer borrador">
        <div><span aria-hidden="true">🙋</span><strong>Vos</strong></div>
        <b aria-hidden="true">→</b>
        <div class="prompt-piece"><span aria-hidden="true">💬</span><strong>Pregunta, instrucción o archivo</strong></div>
        <b aria-hidden="true">→</b>
        <div><span aria-hidden="true">⚙️</span><strong>IA</strong></div>
        <b aria-hidden="true">→</b>
        <div><span aria-hidden="true">📝</span><strong>Primer borrador</strong></div>
      </div>
      <p class="truth"><span aria-hidden="true">🧭</span><strong>No es una contraseña mágica.</strong> Es el comienzo de una conversación.</p>
    </section>

    <section class="visual-block objective" aria-labelledby="objective-title">
      <div class="block-heading">
        <span class="step">02</span>
        <div><p>Antes de pedir</p><h2 id="objective-title">¿Cuál es mi objetivo?</h2></div>
      </div>
      <div class="goal-frame" aria-label="Frase para definir el objetivo">
        <span>Al terminar, quiero tener</span><b>________</b><span>para poder</span><b>________</b>
      </div>
      <div class="objective-compare">
        <article class="blurry"><span>Tema borroso</span><blockquote>“Necesito algo sobre el evento.”</blockquote></article>
        <b aria-hidden="true">→</b>
        <article class="clear"><span>Objetivo claro</span><blockquote>“Necesito un mensaje para que las familias sepan cuándo venir y qué traer.”</blockquote></article>
      </div>
      <p class="tiny-note">Si no sabés qué resultado esperás, tampoco vas a poder evaluarlo.</p>
    </section>

    <section class="visual-block choice" aria-labelledby="choice-title">
      <div class="block-heading">
        <span class="step">03</span>
        <div><p>Motor y profundidad</p><h2 id="choice-title">¿Qué modelo y cuánto esfuerzo necesito?</h2></div>
      </div>
      <div class="decision-grid">
        <article class="model-choice">
          <span class="decision-label">1 · Resultado y motor</span>
          <h3>Primero, elegí qué querés crear</h3>
          <div class="mode-chips" aria-label="Tipos de resultado"><span>Texto</span><span>Imagen</span><span>Audio</span><span>Video</span></div>
          <dl class="choice-legend">
            <div><dt>Herramienta</dt><dd>El lugar que usás para crear.</dd></div>
            <div><dt>Modalidad</dt><dd>Texto, imagen, audio o video.</dd></div>
            <div><dt>Modelo</dt><dd>El motor que trabaja por detrás; muchas aplicaciones lo eligen por vos.</dd></div>
          </dl>
        </article>
        <article class="effort-choice">
          <span class="decision-label">2 · Dificultad de la tarea</span>
          <h3>Asigná la profundidad necesaria</h3>
          <div class="effort-scale" role="list">
            <div role="listitem"><span aria-hidden="true">🌱</span><strong>Rápido</strong><small>Reformular o listar.</small></div>
            <div role="listitem"><span aria-hidden="true">🌿</span><strong>Intermedio</strong><small>Comparar opciones.</small></div>
            <div role="listitem"><span aria-hidden="true">🌳</span><strong>Profundo</strong><small>Analizar o planificar.</small></div>
          </div>
          <p><strong>Esfuerzo</strong> indica cuánto tiempo o profundidad le asigna el producto.</p>
        </article>
      </div>
      <p class="caveat"><strong>Más esfuerzo o un modelo más grande no garantizan una respuesta mejor.</strong> Si no tenés un motivo para cambiar, la opción recomendada suele alcanzar.</p>
    </section>

    <section class="visual-block context" aria-labelledby="context-title">
      <div class="block-heading">
        <span class="step">04</span>
        <div><p>La mochila de contexto</p><h2 id="context-title">¿Qué necesita saber?</h2></div>
      </div>
      <div class="context-grid">
        {level.concepts.map((concept) => (
          <article>
            <span aria-hidden="true">{concept.icon}</span>
            <h3>{concept.title}</h3>
            <p>{concept.text}</p>
          </article>
        ))}
      </div>
      <p class="truth"><span aria-hidden="true">🎒</span><strong>Más contexto no siempre es mejor.</strong> Elegí el que realmente cambia la respuesta.</p>
    </section>

    <section class="visual-block build" aria-labelledby="build-title">
      <div class="block-heading">
        <span class="step">05</span>
        <div><p>Armá el pedido</p><h2 id="build-title">Cuatro piezas alcanzan para empezar</h2></div>
      </div>
      <div class="piece-row" role="list">
        <div class="objective-piece" role="listitem"><span>1</span><strong>Objetivo</strong></div>
        <b aria-hidden="true">+</b>
        <div class="context-piece" role="listitem"><span>2</span><strong>Contexto</strong></div>
        <b aria-hidden="true">+</b>
        <div class="format-piece" role="listitem"><span>3</span><strong>Formato</strong></div>
        <b aria-hidden="true">+</b>
        <div class="criterion-piece" role="listitem"><span>4</span><strong>Criterio</strong></div>
      </div>
      <blockquote class="assembled-prompt">
        <span class="prompt-fragment objective-piece"><small>Objetivo</small>Invitá a las familias a participar del evento.</span>
        <span class="prompt-fragment context-piece"><small>Contexto</small>Todavía no conocen la actividad.</span>
        <span class="prompt-fragment format-piece"><small>Formato</small>Escribí un mensaje de WhatsApp de hasta 80 palabras.</span>
        <span class="prompt-fragment criterion-piece"><small>Criterio</small>Incluí fecha, lugar y qué llevar.</span>
      </blockquote>
      <p class="tiny-note">Rol, tono y ejemplos son opcionales. Agregalos sólo cuando cambien el resultado.</p>
    </section>

    <section class="visual-block iteration" aria-labelledby="iteration-title">
      <div class="block-heading">
        <span class="step">06</span>
        <div><p>Conversar e iterar</p><h2 id="iteration-title">La primera respuesta es un borrador</h2></div>
      </div>
      <ol class="iteration-loop">
        <li><span>1</span><strong>Pedí</strong></li>
        <li><span>2</span><strong>Revisá</strong></li>
        <li><span>3</span><strong>Ajustá</strong></li>
        <li><span>4</span><strong>Verificá</strong></li>
      </ol>
      <div class="followups" aria-label="Ejemplos para continuar la conversación">
        <span>“Acortalo a 60 palabras.”</span>
        <span>“Dame dos versiones.”</span>
        <span>“Usá un tono más directo.”</span>
        <span>“¿Qué supuesto hiciste?”</span>
      </div>
      <p class="truth"><span aria-hidden="true">🔁</span><strong>Corregí una dimensión por vez.</strong> No hace falta empezar de nuevo.</p>
    </section>

    <FieldNote summary="Excavar más · ¿Hace falta decir “actuá como…”?">
      <p>Puede ayudar cuando buscás una perspectiva concreta, pero no es obligatorio. Objetivo, contexto y criterio suelen aportar más.</p>
      <p>Si falta información decisiva, pedile que pregunte. Si no, que declare sus supuestos y avance.</p>
    </FieldNote>

    <TrailSummary
      title="Tres huellas para llevarte"
      items={level.takeaways}
      previousHref={href("parte-1/nivel-1/")}
      previousLabel="Nivel 1"
      mapHref={href("#mapa")}
      nextHref={href("parte-1/nivel-3/")}
      nextLabel="Seguir al Nivel 3"
    />
  </main>
</BaseLayout>

<style>
  .level-page { width: min(1080px, calc(100% - 2rem)); margin: 0 auto; padding: 2rem 0 5rem; }
  .visual-block { margin: 3rem 0; padding: clamp(1.2rem, 4vw, 2.4rem); border-radius: 1.8rem; background: white; box-shadow: 0 18px 50px rgb(32 48 43 / 9%); }
  .prompt, .build { background: #fff8e7; }
  .objective { background: #fff4ec; }
  .choice, .context { background: #f1f8f3; }
  .iteration { background: #eef7fb; }
  .block-heading { display: flex; gap: 1rem; align-items: center; margin-bottom: 1.2rem; }
  .block-heading p { margin: 0; color: #795307; font-size: .75rem; font-weight: 900; text-transform: uppercase; letter-spacing: .08em; }
  .step { display: grid; width: 48px; height: 48px; flex: 0 0 48px; place-items: center; border-radius: 16px; background: #20302b; color: white; font-weight: 900; }
  h2 { margin: .1rem 0 0; font-size: clamp(1.7rem, 4vw, 2.8rem); line-height: 1; }
  .lead { margin: 0 0 1rem; color: #526159; font-size: 1.1rem; }
  .prompt-flow { display: grid; grid-template-columns: .75fr auto 1.45fr auto .75fr auto 1fr; gap: .65rem; align-items: center; }
  .prompt-flow div { min-height: 116px; display: grid; place-items: center; align-content: center; gap: .35rem; padding: .8rem; border: 1px solid #e3d2a0; border-radius: 1rem; background: white; text-align: center; }
  .prompt-flow .prompt-piece { border: 2px solid #d99a1e; }
  .prompt-flow div > span { font-size: 1.75rem; }
  .prompt-flow > b { color: #795307; font-size: 1.35rem; }
  .truth { display: flex; gap: .65rem; align-items: center; margin: 1rem 0 0; padding: .85rem 1rem; border-radius: .9rem; background: #e4f2e9; color: #375249; }
  .goal-frame { display: flex; flex-wrap: wrap; justify-content: center; gap: .65rem; align-items: baseline; padding: 1.1rem; border: 2px dashed #d77b55; border-radius: 1rem; background: white; font-size: clamp(1.05rem, 2.5vw, 1.45rem); }
  .goal-frame b { color: #99412f; letter-spacing: .08em; }
  .objective-compare { display: grid; grid-template-columns: 1fr auto 1fr; gap: .8rem; align-items: center; margin-top: 1rem; }
  .objective-compare article { min-height: 155px; padding: 1rem; border-radius: 1rem; }
  .objective-compare article > span, .decision-label { color: #7d3b26; font-size: .72rem; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; }
  .objective-compare blockquote { margin: .8rem 0 0; font-size: 1.05rem; font-weight: 750; }
  .objective-compare .blurry { background: #ffe5da; }
  .objective-compare .clear { background: #e6f3ea; }
  .objective-compare > b { color: #99412f; font-size: 1.7rem; }
  .tiny-note { margin: 1rem 0 0; color: #526159; }
  .decision-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: 1rem; }
  .decision-grid > article { padding: 1.1rem; border: 1px solid #cbd9d0; border-radius: 1.2rem; background: white; }
  .decision-grid h3 { margin: .45rem 0 .8rem; font-size: 1.3rem; }
  .decision-grid p { margin: .85rem 0 0; color: #526159; }
  .mode-chips { display: flex; flex-wrap: wrap; gap: .45rem; }
  .mode-chips span { padding: .5rem .7rem; border-radius: 999px; background: #e7effb; color: #245c7a; font-weight: 850; }
  .choice-legend { display: grid; gap: .45rem; margin: .9rem 0 0; }
  .choice-legend div { display: grid; grid-template-columns: 84px 1fr; gap: .55rem; padding-top: .45rem; border-top: 1px solid #e1e9e3; }
  .choice-legend dt { color: #20302b; font-weight: 850; }
  .choice-legend dd { margin: 0; color: #526159; }
  .effort-scale { display: grid; grid-template-columns: repeat(3, 1fr); gap: .5rem; }
  .effort-scale div { display: grid; min-height: 110px; justify-items: center; align-content: center; padding: .6rem; border-radius: .8rem; background: #f2f7f3; text-align: center; }
  .effort-scale div > span { font-size: 1.6rem; }
  .effort-scale small { color: #526159; }
  .caveat { margin: 1rem 0 0; padding: .85rem 1rem; border-left: 4px solid #176b55; border-radius: 0 .9rem .9rem 0; background: #e2f0e7; color: #375249; }
  .context-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: .7rem; }
  .context-grid article { padding: 1rem; border: 1px solid #cbd9d0; border-radius: 1rem; background: white; }
  .context-grid article > span { display: grid; width: 42px; height: 42px; place-items: center; border-radius: 14px; background: #e3f3ea; font-size: 1.25rem; }
  .context-grid h3 { margin: .7rem 0 .3rem; }
  .context-grid p { margin: 0; color: #526159; }
  .piece-row { display: grid; grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr; gap: .55rem; align-items: center; }
  .objective-piece { --piece-accent: #28715d; --piece-tint: #e3f3ea; }
  .context-piece { --piece-accent: #8a5a11; --piece-tint: #fff0c9; }
  .format-piece { --piece-accent: #245c7a; --piece-tint: #e7effb; }
  .criterion-piece { --piece-accent: #98472f; --piece-tint: #ffe7dd; }
  .piece-row div { min-height: 92px; display: grid; place-items: center; align-content: center; gap: .3rem; padding: .7rem; border: 1px solid var(--piece-accent); border-radius: .9rem; background: var(--piece-tint); text-align: center; }
  .piece-row div > span { display: grid; width: 28px; height: 28px; place-items: center; border-radius: 50%; background: var(--piece-accent); color: white; font-size: .75rem; font-weight: 900; }
  .piece-row > b { color: #795307; }
  .assembled-prompt { display: grid; grid-template-columns: 1fr 1fr; gap: .65rem; margin: 1rem 0 0; padding: 1rem; border: 2px solid #20302b; border-radius: 1.1rem; background: white; font-size: clamp(.95rem, 2vw, 1.08rem); font-weight: 700; }
  .prompt-fragment { display: grid; grid-template-columns: auto 1fr; gap: .55rem; align-items: center; padding: .7rem .8rem; border-left: 4px solid var(--piece-accent); border-radius: .65rem; background: var(--piece-tint); }
  .prompt-fragment small { color: var(--piece-accent); font-size: .68rem; font-weight: 900; letter-spacing: .06em; text-transform: uppercase; }
  .iteration-loop { display: grid; grid-template-columns: repeat(4, 1fr); gap: .7rem; margin: 0; padding: 0; list-style: none; }
  .iteration-loop li { display: flex; gap: .6rem; align-items: center; padding: .85rem; border-radius: .9rem; background: white; }
  .iteration-loop li > span { display: grid; width: 34px; height: 34px; flex: 0 0 34px; place-items: center; border-radius: 50%; background: #245c7a; color: white; font-weight: 900; }
  .followups { display: flex; flex-wrap: wrap; gap: .55rem; margin-top: 1rem; }
  .followups span { padding: .55rem .7rem; border: 1px solid #bdd5e1; border-radius: 999px; background: white; color: #375a6c; font-size: .9rem; font-weight: 750; }
  @media (max-width: 800px) {
    .prompt-flow, .piece-row { grid-template-columns: 1fr; }
    .prompt-flow > b, .piece-row > b, .objective-compare > b { rotate: 90deg; text-align: center; }
    .objective-compare, .decision-grid, .assembled-prompt { grid-template-columns: 1fr; }
    .context-grid, .iteration-loop { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .context-grid, .effort-scale, .iteration-loop { grid-template-columns: 1fr; }
    .goal-frame { justify-content: flex-start; }
  }
</style>
