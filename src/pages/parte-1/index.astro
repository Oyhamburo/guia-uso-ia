---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DinoAvatar from "../../components/DinoAvatar.astro";
import { initialLevels } from "../../data/part1";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const href = (path: string) => `${base}${path.replace(/^\//, "")}`;
---

<BaseLayout
  title="Expedición inicial · Guía para usar IA"
  description="Tres niveles visuales para aprender a usar IA con claridad, criterio y seguridad."
>
  <main id="contenido" class="part-one-home">
    <section class="intro-panel">
      <div class="intro-copy">
        <p class="eyebrow">Parte 1 · Para todo el mundo</p>
        <h1>Tu primera expedición con IA</h1>
        <p class="lead">Tres paradas. Cero requisitos técnicos. Una idea útil por vez.</p>
        <div class="intro-actions">
          <a class="primary" href={href("parte-1/nivel-1/")}>Empezar la expedición <span aria-hidden="true">→</span></a>
          <a class="secondary" href={href("parte-1/juegos/")}>Ir a los juegos</a>
        </div>
      </div>
      <div class="dino-group" aria-label="Bruna, Paco y Anky son los guías de esta expedición">
        <DinoAvatar name="bruna" mood="celebrating" size="large" />
        <DinoAvatar name="paco" mood="explaining" size="medium" />
        <DinoAvatar name="anky" mood="alert" size="medium" />
      </div>
    </section>

    <section class="route" aria-labelledby="route-title">
      <div class="section-title">
        <p class="eyebrow">El mapa</p>
        <h2 id="route-title">Elegí tu próxima parada</h2>
      </div>
      <ol class="route-list">
        {initialLevels.map((level) => (
          <li class={`route-card route-card--${level.color}`}>
            <a href={href(`parte-1/${level.slug}/`)}>
              <span class="number">0{level.number}</span>
              <div>
                <span class="kicker">{level.kicker}</span>
                <h3>{level.title}</h3>
                <p>{level.promise}</p>
              </div>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
        <li class="route-card route-card--games">
          <a href={href("parte-1/juegos/")}>
            <span class="number">★</span>
            <div>
              <span class="kicker">Campamento de práctica</span>
              <h3>Jugá con lo aprendido</h3>
              <p>Armá pedidos, ordená el ecosistema y medí riesgos.</p>
            </div>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        </li>
      </ol>
    </section>

    <aside class="reassurance">
      <span aria-hidden="true">🌱</span>
      <div><strong>No es una carrera.</strong> Podés entrar a cualquier nivel, volver y repetir los juegos.</div>
    </aside>
  </main>
</BaseLayout>

<style>
  .part-one-home { width: min(1120px, calc(100% - 2rem)); margin: 0 auto; padding: 2rem 0 5rem; }
  .intro-panel { position: relative; overflow: hidden; display: grid; grid-template-columns: 1.1fr .9fr; align-items: center; gap: 1rem; min-height: 520px; padding: clamp(1.5rem, 5vw, 4rem); border-radius: 2.25rem; background: radial-gradient(circle at 85% 15%, #d7f0dc 0 12%, transparent 38%), linear-gradient(135deg, #f8f0d7, #eff8f5); box-shadow: 0 24px 70px rgb(32 48 43 / 12%); }
  .intro-panel::after { content: ""; position: absolute; inset: auto -4% -45px 42%; height: 130px; background: repeating-radial-gradient(ellipse at center, transparent 0 16px, rgb(23 107 85 / 8%) 17px 19px); transform: rotate(-5deg); pointer-events: none; }
  .eyebrow { margin: 0 0 .6rem; color: #176b55; font-size: .78rem; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; }
  h1 { max-width: 11ch; margin: 0; font-size: clamp(3rem, 8vw, 6rem); line-height: .92; letter-spacing: -.055em; }
  .lead { max-width: 42ch; color: #4a5c54; font-size: clamp(1.1rem, 2vw, 1.35rem); }
  .intro-actions { display: flex; flex-wrap: wrap; gap: .7rem; }
  .intro-actions a { min-height: 46px; display: inline-flex; align-items: center; justify-content: center; gap: .5rem; padding: .75rem 1rem; border-radius: 999px; font-weight: 850; text-decoration: none; }
  .primary { background: #176b55; color: white; }
  .secondary { border: 1px solid #9db5aa; background: white; color: #20302b; }
  .dino-group { position: relative; z-index: 1; min-height: 340px; display: grid; grid-template-columns: 1fr 1fr; align-items: end; justify-items: center; }
  .dino-group > :first-child { grid-row: 1 / 3; align-self: center; }
  .route { padding: 5rem 0 2rem; }
  .section-title h2 { max-width: 16ch; margin: 0 0 1.4rem; font-size: clamp(2rem, 5vw, 3.4rem); line-height: 1; }
  .route-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; padding: 0; list-style: none; }
  .route-card a { min-height: 230px; display: grid; grid-template-columns: auto 1fr auto; align-items: start; gap: 1rem; padding: 1.35rem; border: 1px solid #d9d2c2; border-radius: 1.5rem; background: white; color: inherit; text-decoration: none; transition: transform .18s ease, box-shadow .18s ease; }
  .route-card a:hover { transform: translateY(-4px); box-shadow: 0 18px 45px rgb(32 48 43 / 12%); }
  .route-card a:focus-visible { outline: 4px solid #6941a5; outline-offset: 4px; }
  .route-card--sky a { background: #eef8fd; }
  .route-card--amber a { background: #fff8e7; }
  .route-card--fern a { background: #eff8f1; }
  .route-card--games a { background: #f5effc; }
  .number { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 16px; background: #20302b; color: white; font-weight: 900; }
  .kicker { color: #4c6259; font-size: .76rem; font-weight: 850; text-transform: uppercase; letter-spacing: .07em; }
  .route-card h3 { margin: .4rem 0; font-size: clamp(1.4rem, 3vw, 2rem); }
  .route-card p { margin: 0; color: #526159; }
  .arrow { font-size: 1.6rem; }
  .reassurance { display: flex; align-items: center; gap: 1rem; margin-top: 1rem; padding: 1rem 1.2rem; border-radius: 1rem; background: #e8f4ed; }
  .reassurance > span { font-size: 1.8rem; }
  @media (max-width: 760px) {
    .intro-panel { grid-template-columns: 1fr; min-height: auto; }
    .dino-group { min-height: 250px; }
    .route-list { grid-template-columns: 1fr; }
    .route-card a { min-height: 190px; }
  }
  @media (prefers-reduced-motion: reduce) { .route-card a { transition: none; } .route-card a:hover { transform: none; } }
</style>
