---
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const target = `${base}parte-1/nivel-1/`;
const canonical = new URL(target, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
    <title>Comenzando la Parte 1 · Expedición IA</title>
  </head>
  <body>
    <main id="contenido">
      <p>Parte 1 · Primeras huellas</p>
      <h1>La expedición comienza en el Nivel 1</h1>
      <a href={target}>Continuar al Nivel 1 →</a>
    </main>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { min-height: 100vh; display: grid; place-items: center; margin: 0; padding: 1rem; background: #f7f3e8; color: #20302b; font-family: system-ui, sans-serif; }
  main { width: min(620px, 100%); padding: clamp(1.5rem, 6vw, 3rem); border: 2px solid #20302b; border-radius: 1.5rem; background: #fff; box-shadow: 6px 7px 0 #20302b; }
  p { color: #176b55; font-weight: 850; text-transform: uppercase; letter-spacing: .08em; }
  h1 { font-size: clamp(2rem, 7vw, 4rem); line-height: .95; }
  a { min-height: 44px; display: inline-flex; align-items: center; padding: .75rem 1rem; border-radius: 999px; background: #176b55; color: #fff; font-weight: 850; text-decoration: none; }
</style>
