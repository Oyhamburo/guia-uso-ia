---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DinoAvatar from "../../components/DinoAvatar.astro";
import { technicalLevels } from "../../data/part2";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const href = (path: string) => `${base.replace(/\/?$/, "/")}${path}`;
---

<BaseLayout title="Debajo del capó · Expedición IA" description="Una ruta técnica para entender agentes, contexto, herramientas y evidencia." current="parte-2" theme="technical">
  <main id="contenido" class="tech-home">
    <section class="tech-hero">
      <div class="hero-copy">
        <span class="kicker">Parte 2 · Laboratorio del volcán</span>
        <h1>Debajo del capó</h1>
        <p>Ya sabés usar IA con criterio. Ahora abrimos la máquina para entender agentes, contexto y trabajo verificable.</p>
        <div class="audience-note"><span aria-hidden="true">🔬</span><span><b>Esta ruta es opcional.</b> No necesitás completarla para usar IA bien; entrá si querés comprender cómo funciona por dentro.</span></div>
        <a class="primary" href={href(technicalLevels[0].href)}>Entrar al laboratorio →</a>
      </div>
      <div class="hero-dino">
        <DinoAvatar dino="roco" mood="neutral" size="lg" label="Roco, guía del laboratorio técnico" />
        <span>Roco prepara herramientas adaptadas a sus brazos cortos.</span>
      </div>
    </section>

    <section class="route" aria-labelledby="route-title">
      <header><span class="kicker">Tres estaciones</span><h2 id="route-title">La ruta técnica</h2></header>
      <div class="level-grid">
        {technicalLevels.map((level) => (
          <a class:list={["level-card", level.color]} href={href(level.href)}>
            <span class="number">{level.number}</span>
            <div><small>{level.time}</small><h3>{level.title}</h3><p>{level.tagline}</p></div>
            <span class="go" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </section>

    <section class="finish-card">
      <div><span class="kicker">Cierre de la parte 2</span><h2>Preguntas con casos reales</h2><p>Doce escenarios para distinguir controles, contexto y evidencia. Cada respuesta incluye el porqué.</p></div>
      <a class="secondary" href={href("parte-2/preguntas/")}>Ver el desafío técnico</a>
    </section>

    <nav class="page-actions" aria-label="Navegación entre partes">
      <a href={href("parte-1/juegos/")}>← Juegos de la Parte 1</a>
      <a href={href("parte-3/")}>Próxima expedición: Parte 3 →</a>
    </nav>
  </main>
</BaseLayout>

<style>
  .tech-home { width: min(1160px, calc(100% - 2rem)); margin: 0 auto; padding: 2rem 0 5rem; }
  .tech-hero { display: grid; grid-template-columns: 1.15fr .85fr; gap: clamp(1.5rem, 5vw, 4rem); align-items: center; min-height: 66vh; padding: clamp(1.5rem, 5vw, 4.5rem); border-radius: 2rem; background: radial-gradient(circle at 86% 12%, rgba(105,65,165,.36), transparent 34%), linear-gradient(140deg, #172c3a, #203d48); color: #fff; overflow: hidden; }
  .kicker { display: block; color: #f5c45f; font-size: .78rem; font-weight: 900; letter-spacing: .11em; text-transform: uppercase; }
  h1 { max-width: 9ch; margin: .4rem 0 .8rem; font-size: clamp(3.2rem, 9vw, 7.5rem); line-height: .82; letter-spacing: -.065em; }
  .hero-copy > p { max-width: 52ch; color: #dbe8ea; font-size: clamp(1.05rem, 2vw, 1.28rem); }
  .audience-note { display: flex; gap: .7rem; max-width: 48rem; margin: 1.25rem 0; padding: .9rem 1rem; border: 1px solid rgba(255,255,255,.17); border-radius: 1rem; background: rgba(255,255,255,.08); color: #e6edef; }
  .primary, .secondary { display: inline-flex; min-height: 3rem; align-items: center; padding: .75rem 1rem; border-radius: .9rem; text-decoration: none; font-weight: 850; }
  .primary { background: #f5c45f; color: #172c3a; }
  .secondary { border: 1px solid rgba(32,48,43,.2); background: #20302b; color: #fff; }
  .primary:focus-visible, .secondary:focus-visible, .level-card:focus-visible, .page-actions a:focus-visible { outline: 3px solid #d99a1e; outline-offset: 4px; }
  .hero-dino { display: grid; justify-items: center; align-self: end; color: #dbe8ea; text-align: center; }
  .hero-dino span { max-width: 28ch; margin-top: .5rem; font-size: .85rem; }
  .route { padding: clamp(3rem, 7vw, 6rem) 0; }
  .route header { margin-bottom: 1.2rem; }
  .route .kicker, .finish-card .kicker { color: #6941a5; }
  h2 { margin: .25rem 0; font-size: clamp(2rem, 5vw, 4rem); line-height: 1; }
  .level-grid { display: grid; gap: .85rem; }
  .level-card { display: grid; grid-template-columns: auto 1fr auto; gap: 1rem; align-items: center; min-height: 8rem; padding: 1.2rem; border: 1px solid rgba(32,48,43,.14); border-radius: 1.25rem; background: rgba(255,255,255,.78); color: inherit; text-decoration: none; transition: transform .18s ease, box-shadow .18s ease; }
  .level-card:hover { transform: translateY(-2px); box-shadow: 0 16px 34px rgba(32,48,43,.1); }
  .number { display: grid; place-items: center; width: 3.2rem; height: 3.2rem; border-radius: 1rem; background: #ede9fe; color: #4f2f7e; font-weight: 950; }
  .sky .number { background: #dff1f8; color: #245d7c; }
  .fern .number { background: #dff3e9; color: #145c49; }
  .level-card small { color: #5b6863; font-weight: 750; }
  .level-card h3 { margin: .1rem 0 .25rem; font-size: clamp(1.25rem, 3vw, 1.75rem); }
  .level-card p { margin: 0; color: #51605a; }
  .go { font-size: 1.5rem; }
  .finish-card { display: grid; grid-template-columns: 1fr auto; gap: 1.25rem; align-items: center; padding: clamp(1.5rem, 4vw, 2.5rem); border: 1px solid rgba(105,65,165,.25); border-radius: 1.5rem; background: #f3eefc; }
  .finish-card h2 { font-size: clamp(1.7rem, 4vw, 2.8rem); }
  .finish-card p { max-width: 58ch; margin-bottom: 0; color: #51605a; }
  .page-actions { display: flex; justify-content: space-between; gap: 1rem; margin-top: 2rem; }
  .page-actions a { color: #375249; font-weight: 800; }
  @media (max-width: 760px) { .tech-hero { grid-template-columns: 1fr; min-height: auto; } .hero-dino { max-width: 18rem; justify-self: center; } .finish-card { grid-template-columns: 1fr; } .page-actions { flex-direction: column; } }
  @media (prefers-reduced-motion: reduce) { .level-card { transition: none; } .level-card:hover { transform: none; } }
</style>
