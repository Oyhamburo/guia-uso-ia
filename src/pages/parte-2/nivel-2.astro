---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LevelHero from "../../components/LevelHero.astro";
import FieldNote from "../../components/FieldNote.astro";
import ContextPack from "../../components/ContextPack.astro";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const href = (path: string) => `${base.replace(/\/?$/, "/")}${path}`;

const tokenExample = "Los dinosaurios usan IA.";
const characterPairs = tokenExample.match(/.{1,2}/gu) ?? [];
// Verified with tiktoken 0.12.0, o200k_base; leading spaces are part of the tokens.
const realTokens = ["Los", " dinosaur", "ios", " usan", " IA", "."];
const showSpaces = (piece: string) => piece.replaceAll(" ", "␣");
---

<BaseLayout title="T2 · La mochila de contexto" description="Tokens, sesión, peticiones, contexto, posición y compactación explicados visualmente." current="parte-2" theme="technical">
  <main id="contenido" class="tech-level">
    <LevelHero eyebrow="Parte 2 · Nivel técnico 2" title="La mochila de contexto" intro="El modelo no mantiene una conversación abierta por sí mismo. En cada llamada recibe una selección concreta de instrucciones, mensajes, archivos y resultados." dino="bruna" dinoLabel="Bruna ve el mapa completo" guide="Más espacio no significa que cada dato sea igual de visible." tone="sky">
      <div slot="actions" class="hero-actions"><a href="#que-es-contexto">Abrir la mochila ↓</a><a href={href("#mapa")}>Mapa de la expedición</a></div>
    </LevelHero>

    <section id="que-es-contexto" class="visual-section" aria-labelledby="context-intro-title">
      <header>
        <span class="step">01 · Lo que recibe el modelo</span>
        <h2 id="context-intro-title">¿Qué es el contexto?</h2>
        <p>El contexto es toda la información que recibe el modelo para responder en ese momento. Incluye tu pedido y puede incluir mensajes anteriores, instrucciones o partes de un archivo.</p>
      </header>
      <figure class="context-example" data-context-example>
        <figcaption>
          <h3>Una pregunta en la expedición</h3>
          <dl>
            <div><dt>Tu pedido</dt><dd>«¿Por dónde seguimos?»</dd></div>
            <div><dt>Mapa</dt><dd>Muestra los senderos y el río.</dd></div>
            <div><dt>Instrucción</dt><dd>«No cruces el río».</dd></div>
          </dl>
          <p><strong>La mochila lleva las tres cosas, no solo tu pregunta.</strong></p>
        </figcaption>
        <div class="context-illustration">
          <svg viewBox="0 0 320 220" aria-hidden="true" focusable="false">
            <defs>
              <g id="context-question">
                <rect x="-21" y="-21" width="42" height="42" rx="12" fill="#dff0f6" />
                <path d="M-9-7h18v12H0l-5 4V5h-4zM-5-1H5" stroke="#245d7c" />
              </g>
              <g id="context-map">
                <rect x="-21" y="-21" width="42" height="42" rx="12" fill="#def1e7" />
                <path d="m-10-7 7-3 6 3 7-3V7l-7 3-6-3-7 3zM-3-10V7M3-7v17" stroke="#145c49" />
              </g>
              <g id="context-rule">
                <rect x="-21" y="-21" width="42" height="42" rx="12" fill="#fff3d6" />
                <path d="M-6-10H2l4 4v16H-6zM-2-2H2M-2 3H2" stroke="#754a29" />
              </g>
            </defs>
            <ellipse cx="160" cy="199" rx="70" ry="8" fill="#dff0f6" />
            <path class="context-trails" d="M48 54Q100 61 147 101M160 54V101M272 54Q220 61 173 101" />
            <use href="#context-question" x="48" y="31" />
            <use href="#context-map" x="160" y="31" />
            <use href="#context-rule" x="272" y="31" />
            <path d="M107 137a12 12 0 0 0-12 12v24a12 12 0 0 0 12 12m106-48a12 12 0 0 1 12 12v24a12 12 0 0 1-12 12" fill="none" stroke="#245d7c" stroke-width="6" />
            <path d="M116 108Q160 86 204 108L196 130H124Z" fill="#172c3a" />
            <use href="#context-question" x="48" y="31" class="context-flight" data-context-flight data-travel="100" />
            <use href="#context-map" x="160" y="31" class="context-flight" data-context-flight data-travel="0" />
            <use href="#context-rule" x="272" y="31" class="context-flight" data-context-flight data-travel="-100" />
            <path d="M109 111q51 19 102 0v61q0 23-22 23h-58q-22 0-22-23Z" fill="#2f7196" stroke="#245d7c" stroke-width="3" />
            <rect x="135" y="148" width="50" height="34" rx="10" fill="#8fd5e9" stroke="#245d7c" stroke-width="2" />
            <path d="M147 157h26" stroke="#245d7c" stroke-width="2" stroke-linecap="round" />
            <rect x="147" y="119" width="26" height="13" rx="4" fill="#f5c45f" />
          </svg>
          <button type="button" class="context-replay" data-replay-context hidden>Ver cómo se arma la mochila</button>
        </div>
      </figure>
    </section>

    <section id="entrada-modelo" class="visual-section context-measure" aria-labelledby="entrada-modelo-title">
      <header>
        <span class="step">01B · Medir el uso</span>
        <h2 id="entrada-modelo-title">¿Cuánto contexto estamos usando?</h2>
        <p>La misma pregunta puede ocupar más espacio si la app envía más información junto con tu pedido.</p>
      </header>
      <div class="context-usage">
        <figure class="usage-example">
          <figcaption>
            <strong>Misma pregunta: «¿Por dónde seguimos?»</strong>
            <span>En este ejemplo, hay espacio para 12.000 tokens de entrada.</span>
          </figcaption>
          <div class="usage-case">
            <div><strong id="usage-basic-label">Pedido + historial reciente</strong><b>25 %</b></div>
            <meter min="0" value="3000" max="12000" aria-labelledby="usage-basic-label">25 %</meter>
            <p>3.000 tokens usados · quedan 9.000</p>
          </div>
          <div class="usage-case with-report">
            <div><strong id="usage-report-label">Lo mismo + el informe de la expedición</strong><b>75 %</b></div>
            <meter min="0" value="9000" max="12000" aria-labelledby="usage-report-label">75 %</meter>
            <p>9.000 tokens usados · quedan 3.000</p>
          </div>
        </figure>
        <article class="usage-method">
          <h3>¿Cómo se calcula?</h3>
          <ol>
            <li>Contá los tokens de <strong>toda la entrada</strong>, no solo los del último mensaje.</li>
            <li>Dividí el total por los tokens disponibles para la entrada y multiplicá por 100.</li>
          </ol>
          <p class="usage-equation">9.000 ÷ 12.000 × 100 = <strong>75 %</strong></p>
          <p class="usage-note"><strong>¿Dónde lo ves?</strong> Buscá un medidor de contexto en la app. Si usás una API, consultá el conteo de tokens de entrada que reporta.</p>
        </article>
      </div>
    </section>

    <section id="tokens" class="visual-section" aria-labelledby="token-title">
      <header><span class="step">02 · La unidad variable</span><h2 id="token-title">¿Qué es un token?</h2><p>Un token es una de las piezas en las que el <i>tokenizer</i> divide el texto antes de que el modelo lo procese. Las piezas no tienen un tamaño fijo.</p></header>
      <figure class="token-comparison">
        <figcaption><strong>Mismo texto: «{tokenExample}»</strong><span><code>␣</code> marca un espacio.</span></figcaption>
        <div class="token-board">
          <div class="fixed-pairs">
            <span class="board-label">Corte inventado: de a dos caracteres</span>
            <ul class="token-pieces" data-token-example="pairs" aria-label="Pares de caracteres, no tokens">
              {characterPairs.map((piece) => <li>{showSpaces(piece)}</li>)}
            </ul>
            <strong data-token-count="pairs" data-count={characterPairs.length}>{characterPairs.length} pares · no son tokens</strong>
          </div>
          <div class="token-demo">
            <span class="board-label">Tokenización real de OpenAI · <code>o200k_base</code></span>
            <ul class="token-pieces" data-token-example="real" aria-label="Tokens reales de o200k_base">
              {realTokens.map((piece) => <li>{showSpaces(piece)}</li>)}
            </ul>
            <strong data-token-count="real" data-count={realTokens.length}>{realTokens.length} tokens</strong>
          </div>
        </div>
      </figure>
      <div class="token-facts" role="list" aria-label="Propiedades de los tokens"><p role="listitem"><b>No hay tamaño fijo</b><span>Un token puede ser un signo, una palabra o parte de ella. Incluso 🦖 ocupa 3 tokens con este tokenizer.</span></p><p role="listitem"><b>Depende del tokenizer</b><span>Otro modelo puede dividir la misma frase de otra manera.</span></p><p role="listitem"><b>Para medir el contexto</b><span>Usá el conteo de tokens del modelo; no dividas los caracteres por dos.</span></p></div>
      <div class="budget" aria-label="Ejemplo conceptual del reparto de una ventana de contexto">
        <div class="rules">Instrucciones</div><div class="chat">Conversación</div><div class="files">Archivos</div><div class="tools">Tools</div><div class="output">Salida</div>
      </div>
      <small class="caption"><b>Entrada y salida comparten presupuesto.</b> Las proporciones cambian según la tarea, el modelo y la API.</small>
    </section>

    <section id="tokens-entrada-salida" class="visual-section" aria-labelledby="token-flow-title">
      <header>
        <span class="step">02B · Entrada y salida</span>
        <h2 id="token-flow-title">¿Entra al modelo o sale de él?</h2>
        <p>No son dos tipos distintos de token. La diferencia es si el modelo recibe ese token o lo genera en esa llamada.</p>
      </header>
      <div class="token-flow">
        <article>
          <h3>Tokens de entrada</h3>
          <p>Son los que recibe el modelo: tu pedido más todo lo que la app incluya para que pueda responder.</p>
          <p class="token-flow-example">«¿Por dónde seguimos?»</p>
        </article>
        <article>
          <h3>Tokens de salida</h3>
          <p>Son los que genera el modelo. En este ejemplo, forman la respuesta que ves.</p>
          <p class="token-flow-example">«Sigamos por el sendero norte.»</p>
        </article>
      </div>
      <p class="truth"><b>La misma frase puede cambiar de lado.</b> Si esa respuesta se vuelve a enviar como parte del historial en la próxima llamada, ahora cuenta como entrada.</p>
    </section>

    <ContextPack />

    <section class="visual-section" aria-labelledby="position-title">
      <header><span class="step">03A · La posición</span><h2 id="position-title">Lost in the middle: importa dónde está</h2><p>Un dato puede entrar en la ventana y aun así recuperarse peor si queda enterrado en el medio.</p></header>
      <div class="position-card">
        <div class="curve" role="img" aria-label="Curva conceptual con mejor recuperación al principio y al final, y menor recuperación en el centro">
          <svg viewBox="0 0 640 260" aria-hidden="true">
            <path class="axis" d="M55 30V210H600" /><path class="line" d="M70 60C180 72 185 180 320 187C455 180 470 72 585 58" />
            <circle cx="70" cy="60" r="8" /><circle class="risk" cx="320" cy="187" r="8" /><circle cx="585" cy="58" r="8" />
            <text x="56" y="238">Inicio</text><text x="295" y="238">Medio</text><text x="550" y="238">Final</text>
          </svg>
        </div>
        <div><h3>Es un problema de posición</h3><p>En contextos largos, distintos modelos mostraron una tendencia: recuperan mejor información ubicada al principio o al final.</p><b class="practice-label">Prácticas que pueden ayudar</b><ul><li>Reglas críticas al comienzo.</li><li>Material largo con títulos claros.</li><li>Objetivo reforzado al final.</li></ul><p class="caveat">Es una tendencia medida, no una ley universal.</p></div>
      </div>
      <p class="source">Referencia: <a href="https://aclanthology.org/2024.tacl-1.9/" rel="noreferrer">Lost in the Middle, TACL 2024</a>.</p>
    </section>

    <section class="visual-section" aria-labelledby="rot-title">
      <header><span class="step">03B · El volumen y el ruido</span><h2 id="rot-title">Context rot: entrar no significa usarse bien</h2><p>Aunque todo siga dentro de la ventana, puede degradarse la capacidad de usar el dato correcto.</p></header>
      <div class="rot-board" role="group" aria-label="La misma regla crítica rodeada por cantidades crecientes de contexto y ruido">
        <article><span class="rot-stage">Contexto corto</span><div class="signal-field low-noise"><b>Regla crítica</b><i></i><i></i></div><p>La señal se distingue.</p></article>
        <article><span class="rot-stage">Contexto largo</span><div class="signal-field more-noise"><i></i><i></i><i></i><b>Regla crítica</b><i></i><i></i><i></i><i></i></div><p>La misma señal compite con más datos.</p></article>
        <article><span class="rot-stage">Contexto contradictorio</span><div class="signal-field conflict"><i></i><b>Regla crítica</b><em>Regla vieja</em><i></i><em>Otra versión</em><i></i></div><p>El sistema debe resolver qué versión vale.</p></article>
      </div>
      <div class="problem-compare"><p><b>Lost in the middle</b><span>¿Dónde quedó el dato?</span></p><p><b>Context rot</b><span>¿Qué cambia cuando crecen la longitud, el ruido y la complejidad?</span></p></div>
      <p class="truth warning"><b>No hay un punto universal donde “se rompe”.</b> La degradación depende del modelo, la tarea, la posición y la calidad del material.</p>
      <p class="source">Referencia: <a href="https://www.trychroma.com/research/context-rot" rel="noreferrer">Context Rot, Chroma Research</a>.</p>
    </section>

    <section class="visual-section" aria-labelledby="compact-title">
      <header><span class="step">04 · Administrar lo que no entra</span><h2 id="compact-title">No compactes todo de la misma manera</h2><p>Compactar bien es decidir qué debe quedar exacto, qué puede resumirse y qué conviene recuperar sólo cuando haga falta.</p></header>
      <div class="compact-strategy" role="list" aria-label="Cuatro destinos posibles al compactar contexto">
        <article role="listitem"><span class="strategy-icon exact" aria-hidden="true">＝</span><h3>Conservar textual</h3><p>Límites, decisiones, cifras, IDs y excepciones.</p></article>
        <article role="listitem"><span class="strategy-icon summary" aria-hidden="true">≋</span><h3>Resumir</h3><p>Historia, avance y razonamiento ya cerrado.</p></article>
        <article role="listitem"><span class="strategy-icon discard" aria-hidden="true">×</span><h3>Descartar</h3><p>Repetición y logs que ya no cambian la decisión; lo auditable queda afuera.</p></article>
        <article role="listitem"><span class="strategy-icon retrieve" aria-hidden="true">↗</span><h3>Recuperar después</h3><p>Archivos y fuentes que una tool puede volver a leer.</p></article>
      </div>
      <div class="loss-demo" role="group" aria-label="Ejemplo de una compactación que pierde información crítica"><article><span>Original</span><p>“Publicar el viernes <mark>sólo si Pagos está estable</mark>. Responsable: Ana.”</p></article><span aria-hidden="true">→</span><article><span>Resumen pobre</span><p>“Publicar el viernes.”</p><small>Perdió la condición y la responsable.</small></article></div>
      <p class="truth warning"><b>Compactar puede perder información.</b> Cuanto más se resume o descarta, más importante es conservar textualmente límites, decisiones y excepciones.</p>
    </section>

    <FieldNote summary="Ventanas publicadas: una foto fechada" variant="technical">
      <p>Estos números cambian rápido y no garantizan recuperación perfecta. Verificados el <time datetime="2026-11-06">6 de noviembre de 2026</time>:</p>
      <div class="model-windows">
        <span><b>GPT-6 Astra</b><small>1.050.000 tokens</small></span>
        <span><b>Claude Fable 5.1 / Opus 5.5 / Sonnet 5.5 / Haiku 5.5</b><small>1.000.000 tokens</small></span>
        <span><b>Gemini 3.8 Flash</b><small>1.048.576 tokens de entrada</small></span>
      </div>
      <p class="source">Fuentes oficiales: <a href="https://developers.openai.com/api/docs/models/gpt-6-astra" rel="noreferrer">OpenAI</a>, <a href="https://platform.claude.com/docs/en/models/overview" rel="noreferrer">Anthropic</a> y <a href="https://ai.google.dev/gemini-api/docs/models/gemini-3.8-flash" rel="noreferrer">Google</a>.</p>
    </FieldNote>

    <section class="quick-check"><span class="step">Chequeo de salida</span><h2>La ventana marca el máximo.<br><strong>La selección, la posición y la calidad deciden qué tan útil resulta.</strong></h2></section>

    <nav class="level-actions" aria-label="Navegación del recorrido técnico"><a href={href("parte-2/nivel-1/")}>← Anatomía de un agente</a><a class="map-link" href={href("#mapa")}>Mapa</a><a class="next" href={href("parte-2/nivel-3/")}>Siguiente: trabajo confiable →</a></nav>
  </main>
</BaseLayout>

<script>
  const example = document.querySelector<HTMLElement>("[data-context-example]");
  const replay = example?.querySelector<HTMLButtonElement>("[data-replay-context]");
  if (example && replay) {
    const illustration = replay.parentElement!;
    const packets = [...illustration.querySelectorAll<SVGUseElement>("[data-context-flight]")];
    const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let animations: Animation[] = [];

    function packContext() {
      if (motion.matches) return;
      animations.forEach((animation) => animation.cancel());
      animations = packets.map((packet, index) => {
        const distance = Number(packet.dataset.travel);
        return packet.animate([
          { transform: "translate(0, 0)", opacity: 1 },
          { transform: `translate(${distance * .6}px, 25px)`, opacity: 1, offset: .55 },
          { transform: `translate(${distance}px, 85px)`, opacity: 0 }
        ], { duration: 780, delay: index * 290, easing: "ease-in-out" });
      });
    }

    replay.hidden = false;
    replay.addEventListener("click", packContext);
    const observer = new IntersectionObserver(([entry]) => {
      if (!entry?.isIntersecting) return;
      observer.disconnect();
      packContext();
    }, { threshold: .5 });
    observer.observe(illustration);
    motion.addEventListener("change", () => {
      if (motion.matches) animations.forEach((animation) => animation.cancel());
    });
  }

</script>

<style>
  .context-example { display: grid; grid-template-columns: 1fr minmax(0, 24rem); align-items: center; gap: clamp(1rem, 4vw, 2rem); margin: 0; padding: clamp(1rem, 4vw, 2rem); border: 1px solid rgba(47,113,150,.22); border-radius: 1.4rem; background: #edf7fa; }
  .context-example h3 { margin: 0 0 .9rem; font-size: 1.25rem; }
  .context-example dl { display: grid; gap: .55rem; margin: 0; }
  .context-example dt { color: #245d7c; font-weight: 850; }
  .context-example dd { margin: 0; }
  .context-example p { margin: .9rem 0 0; }
  .context-illustration { display: grid; justify-items: center; gap: .35rem; }
  .context-illustration svg { display: block; width: 100%; max-width: 20rem; height: auto; }
  .context-illustration defs path { fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .context-trails { fill: none; stroke: #2f7196; stroke-width: 2; stroke-dasharray: 2 5; stroke-linecap: round; }
  .context-flight { opacity: 0; }
  .context-replay:not([hidden]) { min-height: 2.75rem; padding: .5rem .8rem; border: 1px solid #2f7196; border-radius: .8rem; background: #fff; color: #245d7c; font: inherit; font-weight: 800; cursor: pointer; }
  .context-replay:focus-visible { outline: 3px solid #245d7c; outline-offset: 3px; }
  @media (max-width: 680px) { .context-example { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .context-replay:not([hidden]) { display: none; } }
  .tech-level { width: min(1100px, calc(100% - 2rem)); margin: 0 auto; padding-bottom: 5rem; }.hero-actions { display: flex; flex-wrap: wrap; gap: .65rem; }.hero-actions a { min-height: 2.75rem; display: inline-flex; align-items: center; padding: .65rem .9rem; border-radius: .8rem; background: #fff; color: #20302b; text-decoration: none; font-weight: 850; }
  .visual-section { padding: clamp(3rem, 8vw, 6.5rem) 0 0; scroll-margin-top: 6rem; }.visual-section > header { max-width: 780px; margin-bottom: 1.25rem; }.step { display: block; color: #245d7c; font-size: .75rem; font-weight: 900; letter-spacing: .11em; text-transform: uppercase; }h2 { margin: .35rem 0 .6rem; font-size: clamp(2rem, 5vw, 4rem); line-height: 1; letter-spacing: -.035em; }header p, article p { color: #51605a; }
  .token-flow { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; }
  .token-flow article { display: grid; grid-template-rows: auto 1fr auto; padding: clamp(1rem, 2.4vw, 1.65rem); border: 1px solid rgba(47,113,150,.22); border-radius: 1.25rem; background: #edf7fa; }
  .token-flow article + article { background: #172c3a; color: #fff; }
  .token-flow h3 { margin: 0; font-size: clamp(1.25rem, 2.6vw, 1.75rem); }
  .token-flow article p { margin: .45rem 0 0; }
  .token-flow article + article p { color: #dce6e8; }
  .token-flow article .token-flow-example { margin-top: 1rem; padding: .65rem .85rem; border-radius: .7rem; background: #dff0f6; color: #245d7c; font-weight: 800; }
  .token-flow article + article .token-flow-example { background: rgba(255,255,255,.12); color: #fff; }
  @media (max-width: 760px) { .token-flow { grid-template-columns: minmax(0, 1fr); } }
  .truth { margin: 1rem 0 0; padding: 1rem 1.15rem; border-left: 4px solid #2f7196; border-radius: 0 1rem 1rem 0; background: #e7f4fa; color: #4f5d58; }.truth.warning { border-color: #d99a1e; background: #fff7e5; }
  .visual-section.context-measure > header { max-width: none; }
  .context-measure > header p { max-width: 68ch; }
  .context-usage { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr); gap: .8rem; }
  .usage-example, .usage-method { margin: 0; padding: clamp(1rem, 2.2vw, 1.55rem); border-radius: 1.25rem; }
  .usage-example { background: #172c3a; color: #fff; }
  .usage-example figcaption { display: grid; gap: .25rem; margin-bottom: .7rem; }
  .usage-example figcaption strong, .usage-method h3 { font-size: clamp(1.12rem, 2vw, 1.5rem); line-height: 1.2; }
  .usage-example figcaption span, .usage-case p { color: #dce6e8; }
  .usage-case { padding-top: .65rem; border-top: 1px solid rgba(255,255,255,.24); }
  .usage-case + .usage-case { margin-top: .65rem; }
  .usage-case > div { display: flex; justify-content: space-between; align-items: baseline; gap: .5rem 1rem; }
  .usage-case b { color: #8fd5e9; font-size: 1.35rem; white-space: nowrap; }
  .usage-case p { margin: .22rem 0 0; font-size: .9rem; }
  .usage-case meter { display: block; width: 100%; height: 1.5rem; }
  .usage-case meter::-webkit-meter-bar { border: 0; border-radius: .4rem; background: #3b5362; }
  .usage-case meter::-webkit-meter-optimum-value { border-radius: .4rem; background: #8fd5e9; }
  .usage-case meter::-moz-meter-bar { border-radius: .4rem; background: #8fd5e9; }
