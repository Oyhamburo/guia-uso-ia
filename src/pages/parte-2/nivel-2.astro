---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LevelHero from "../../components/LevelHero.astro";
import FieldNote from "../../components/FieldNote.astro";
import ContextPack from "../../components/ContextPack.astro";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const href = (path: string) => `${base.replace(/\/?$/, "/")}${path}`;
---

<BaseLayout title="T2 · La mochila de contexto" description="Tokens, sesión, peticiones, contexto, posición y compactación explicados visualmente." current="parte-2" theme="technical">
  <main id="contenido" class="tech-level">
    <LevelHero eyebrow="Parte 2 · Nivel técnico 2" title="La mochila de contexto" intro="El modelo no mantiene una conversación abierta por sí mismo. En cada llamada recibe una selección concreta de instrucciones, mensajes, archivos y resultados." dino="bruna" dinoLabel="Bruna ve el mapa completo" guide="Más espacio no significa que cada dato sea igual de visible." tone="sky">
      <div slot="actions" class="hero-actions"><a href="#mesa">Abrir la mochila ↓</a><a href={href("#mapa")}>Mapa de la expedición</a></div>
    </LevelHero>

    <section id="mesa" class="visual-section" aria-labelledby="mesa-title">
      <header><span class="step">01 · Guardar no es enviar</span><h2 id="mesa-title">La sesión guarda. El contexto viaja.</h2><p>La aplicación puede conservar mucho más de lo que el modelo recibe en una llamada.</p></header>
      <div class="session-context" role="group" aria-label="La aplicación combina material guardado, instrucciones y datos recuperados para armar el contexto de una petición y enviarlo al modelo">
        <article class="session-store"><span class="diagram-label">Vive en la aplicación</span><h3>Sesión</h3><p>Todo lo que la app conserva durante el trabajo.</p><div class="session-items" aria-label="Ejemplos guardados en la sesión"><span>20 mensajes</span><span>3 archivos</span><span>Estado</span><span>Resultados</span></div></article>
        <div class="request-bridge"><span aria-hidden="true">→</span><b>Petición</b><small>combina lo guardado con instrucciones y datos recuperados</small></div>
        <article class="context-call"><span class="diagram-label">Viaja en esta llamada</span><h3>Contexto</h3><p>El paquete exacto que la app arma para el modelo.</p><div class="context-items"><span>Instrucciones</span><span>Mensajes elegidos</span><span>Datos recuperados</span></div></article>
        <span class="arrow" aria-hidden="true">→</span>
        <article class="model-receives"><span aria-hidden="true">◇</span><h3>Modelo</h3><p>Sólo ve este paquete.</p></article>
      </div>
      <p class="truth"><b>En un chat corto pueden parecer iguales, pero no lo son.</b> Algo puede seguir visible en la sesión y no viajar en el contexto actual. Si la aplicación guarda la respuesta, pasa a formar parte de la sesión.</p>
    </section>

    <section class="visual-section" aria-labelledby="token-title">
      <header><span class="step">02 · La unidad variable</span><h2 id="token-title">Un token no mide dos caracteres</h2><p>Es una unidad elegida por el tokenizer del modelo. Puede representar un signo, una palabra corta o una parte de una palabra.</p></header>
      <div class="token-board">
        <div class="fixed-pairs" aria-label="Idea incorrecta: dividir siempre el texto en pares de caracteres"><span class="board-label">No funciona así</span><p><s>di · no · sa · ur · io</s><b aria-hidden="true">×</b></p><small>No se corta siempre en pares fijos.</small></div>
        <div class="token-demo" aria-label="Fragmentos ilustrativos de longitud variable; no representan un tokenizer concreto"><span class="board-label">Fragmentos ilustrativos</span><div><i>Los</i><i>&nbsp;dinosaur</i><i>ios</i><i>&nbsp;usan</i><i>&nbsp;IA</i><i>.</i></div><small>No es una tokenización real: muestra que las piezas pueden tener longitudes distintas.</small></div>
      </div>
      <div class="token-facts" role="list" aria-label="Propiedades de los tokens"><p role="listitem"><b>Longitud variable</b><span>Uno o varios caracteres.</span></p><p role="listitem"><b>Depende del modelo</b><span>Cada tokenizer decide sus piezas.</span></p><p role="listitem"><b>Conviene medir</b><span>No adivinar el conteo.</span></p></div>
      <div class="budget" aria-label="Ejemplo conceptual del reparto de una ventana de contexto">
        <div class="rules">Instrucciones</div><div class="chat">Conversación</div><div class="files">Archivos</div><div class="tools">Tools</div><div class="output">Salida</div>
      </div>
      <small class="caption"><b>Entrada y salida comparten presupuesto.</b> Las proporciones cambian según la tarea, el modelo y la API.</small>
    </section>

    <ContextPack />

    <section class="visual-section" aria-labelledby="position-title">
      <header><span class="step">03A · La posición</span><h2 id="position-title">Lost in the middle: importa dónde está</h2><p>Un dato puede entrar en la ventana y aun así recuperarse peor si queda enterrado en el medio.</p></header>
      <div class="position-card">
        <div class="curve" role="img" aria-label="Curva conceptual con mejor recuperación al principio y al final, y menor recuperación en el centro">
          <svg viewBox="0 0 640 260" aria-hidden="true">
            <path class="axis" d="M55 30V210H600" /><path class="line" d="M70 60C180 72 185 180 320 187C455 180 470 72 585 58" />
            <circle cx="70" cy="60" r="8" /><circle class="risk" cx="320" cy="187" r="8" /><circle cx="585" cy="58" r="8" />
            <text x="56" y="238">Inicio</text><text x="295" y="238">Medio</text><text x="550" y="238">Final</text>
          </svg>
        </div>
        <div><h3>Es un problema de posición</h3><p>En contextos largos, distintos modelos mostraron una tendencia: recuperan mejor información ubicada al principio o al final.</p><b class="practice-label">Prácticas que pueden ayudar</b><ul><li>Reglas críticas al comienzo.</li><li>Material largo con títulos claros.</li><li>Objetivo reforzado al final.</li></ul><p class="caveat">Es una tendencia medida, no una ley universal.</p></div>
      </div>
      <p class="source">Referencia: <a href="https://aclanthology.org/2024.tacl-1.9/" rel="noreferrer">Lost in the Middle, TACL 2024</a>.</p>
    </section>

    <section class="visual-section" aria-labelledby="rot-title">
      <header><span class="step">03B · El volumen y el ruido</span><h2 id="rot-title">Context rot: entrar no significa usarse bien</h2><p>Aunque todo siga dentro de la ventana, puede degradarse la capacidad de usar el dato correcto.</p></header>
      <div class="rot-board" role="group" aria-label="La misma regla crítica rodeada por cantidades crecientes de contexto y ruido">
        <article><span class="rot-stage">Contexto corto</span><div class="signal-field low-noise"><b>Regla crítica</b><i></i><i></i></div><p>La señal se distingue.</p></article>
        <article><span class="rot-stage">Contexto largo</span><div class="signal-field more-noise"><i></i><i></i><i></i><b>Regla crítica</b><i></i><i></i><i></i><i></i></div><p>La misma señal compite con más datos.</p></article>
        <article><span class="rot-stage">Contexto contradictorio</span><div class="signal-field conflict"><i></i><b>Regla crítica</b><em>Regla vieja</em><i></i><em>Otra versión</em><i></i></div><p>El sistema debe resolver qué versión vale.</p></article>
      </div>
      <div class="problem-compare"><p><b>Lost in the middle</b><span>¿Dónde quedó el dato?</span></p><p><b>Context rot</b><span>¿Qué cambia cuando crecen la longitud, el ruido y la complejidad?</span></p></div>
      <p class="truth warning"><b>No hay un punto universal donde “se rompe”.</b> La degradación depende del modelo, la tarea, la posición y la calidad del material.</p>
      <p class="source">Referencia: <a href="https://www.trychroma.com/research/context-rot" rel="noreferrer">Context Rot, Chroma Research</a>.</p>
    </section>

    <section class="visual-section" aria-labelledby="compact-title">
      <header><span class="step">04 · Administrar lo que no entra</span><h2 id="compact-title">No compactes todo de la misma manera</h2><p>Compactar bien es decidir qué debe quedar exacto, qué puede resumirse y qué conviene recuperar sólo cuando haga falta.</p></header>
      <div class="compact-strategy" role="list" aria-label="Cuatro destinos posibles al compactar contexto">
        <article role="listitem"><span class="strategy-icon exact" aria-hidden="true">＝</span><h3>Conservar textual</h3><p>Límites, decisiones, cifras, IDs y excepciones.</p></article>
        <article role="listitem"><span class="strategy-icon summary" aria-hidden="true">≋</span><h3>Resumir</h3><p>Historia, avance y razonamiento ya cerrado.</p></article>
        <article role="listitem"><span class="strategy-icon discard" aria-hidden="true">×</span><h3>Descartar</h3><p>Repetición y logs que ya no cambian la decisión; lo auditable queda afuera.</p></article>
        <article role="listitem"><span class="strategy-icon retrieve" aria-hidden="true">↗</span><h3>Recuperar después</h3><p>Archivos y fuentes que una tool puede volver a leer.</p></article>
      </div>
      <div class="loss-demo" role="group" aria-label="Ejemplo de una compactación que pierde información crítica"><article><span>Original</span><p>“Publicar el viernes <mark>sólo si Pagos está estable</mark>. Responsable: Ana.”</p></article><span aria-hidden="true">→</span><article><span>Resumen pobre</span><p>“Publicar el viernes.”</p><small>Perdió la condición y la responsable.</small></article></div>
      <p class="truth warning"><b>Compactar puede perder información.</b> Cuanto más se resume o descarta, más importante es conservar textualmente límites, decisiones y excepciones.</p>
    </section>

    <FieldNote summary="Ventanas publicadas: una foto fechada" variant="technical">
      <p>Estos números cambian rápido y no garantizan recuperación perfecta. Verificados el <time datetime="2026-11-06">6 de noviembre de 2026</time>:</p>
      <div class="model-windows">
        <span><b>GPT-6 Astra</b><small>1.050.000 tokens</small></span>
        <span><b>Claude Fable 5.1 / Opus 5.5 / Sonnet 5.5 / Haiku 5.5</b><small>1.000.000 tokens</small></span>
        <span><b>Gemini 3.8 Flash</b><small>1.048.576 tokens de entrada</small></span>
      </div>
      <p class="source">Fuentes oficiales: <a href="https://developers.openai.com/api/docs/models/gpt-6-astra" rel="noreferrer">OpenAI</a>, <a href="https://platform.claude.com/docs/en/models/overview" rel="noreferrer">Anthropic</a> y <a href="https://ai.google.dev/gemini-api/docs/models/gemini-3.8-flash" rel="noreferrer">Google</a>.</p>
    </FieldNote>

    <section class="quick-check"><span class="step">Chequeo de salida</span><h2>La ventana marca el máximo.<br><strong>La selección, la posición y la calidad deciden qué tan útil resulta.</strong></h2></section>

    <nav class="level-actions" aria-label="Navegación del recorrido técnico"><a href={href("parte-2/nivel-1/")}>← Anatomía de un agente</a><a class="map-link" href={href("#mapa")}>Mapa</a><a class="next" href={href("parte-2/nivel-3/")}>Siguiente: trabajo confiable →</a></nav>
  </main>
</BaseLayout>

<style>
  .tech-level { width: min(1100px, calc(100% - 2rem)); margin: 0 auto; padding-bottom: 5rem; }.hero-actions { display: flex; flex-wrap: wrap; gap: .65rem; }.hero-actions a { min-height: 2.75rem; display: inline-flex; align-items: center; padding: .65rem .9rem; border-radius: .8rem; background: #fff; color: #20302b; text-decoration: none; font-weight: 850; }
  .visual-section { padding: clamp(3rem, 8vw, 6.5rem) 0 0; scroll-margin-top: 6rem; }.visual-section > header { max-width: 780px; margin-bottom: 1.25rem; }.step { display: block; color: #245d7c; font-size: .75rem; font-weight: 900; letter-spacing: .11em; text-transform: uppercase; }h2 { margin: .35rem 0 .6rem; font-size: clamp(2rem, 5vw, 4rem); line-height: 1; letter-spacing: -.035em; }header p, article p { color: #51605a; }
  .session-context { display: grid; grid-template-columns: 1.15fr auto 1fr auto .68fr; gap: .65rem; align-items: center; padding: .9rem; border: 1px solid rgba(47,113,150,.22); border-radius: 1.4rem; background: #edf7fa; }.session-context article { min-height: 12rem; padding: 1rem; border-radius: 1rem; background: #fff; }.session-context h3 { margin: .35rem 0 .25rem; font-size: 1.35rem; }.session-context p { margin: 0; }.diagram-label { color: #245d7c; font-size: .67rem; font-weight: 900; letter-spacing: .09em; text-transform: uppercase; }.session-items { display: grid; grid-template-columns: 1fr 1fr; gap: .35rem; margin-top: .8rem; }.session-items span,.context-items span { padding: .4rem .5rem; border-radius: .55rem; background: #e9f3f6; color: #375249; font-size: .75rem; font-weight: 800; }.request-bridge { display: grid; max-width: 8.5rem; justify-items: center; gap: .15rem; color: #245d7c; text-align: center; }.request-bridge > span { font-size: 1.5rem; font-weight: 900; }.request-bridge small { color: #65716d; line-height: 1.25; }.context-call { border: 2px solid rgba(105,65,165,.28); }.context-items { display: grid; gap: .35rem; margin-top: .8rem; }.context-items span { background: #f0ebfa; }.arrow { color: #2f7196; font-size: 1.35rem; font-weight: 900; }.model-receives { display: grid; min-width: 0; justify-items: center; align-content: center; text-align: center; background: #172c3a!important; color: #fff; }.model-receives > span { display: grid; width: 2.6rem; height: 2.6rem; place-items: center; border-radius: .8rem; background: rgba(255,255,255,.12); color: #8fd5e9; font-size: 1.3rem; }.model-receives p { color: #dce6e8; }
  .truth { margin: 1rem 0 0; padding: 1rem 1.15rem; border-left: 4px solid #2f7196; border-radius: 0 1rem 1rem 0; background: #e7f4fa; color: #4f5d58; }.truth.warning { border-color: #d99a1e; background: #fff7e5; }
  .token-board { display: grid; grid-template-columns: .8fr 1.2fr; gap: .75rem; }.fixed-pairs,.token-demo { min-height: 10rem; padding: 1.1rem; border-radius: 1.2rem; }.fixed-pairs { border: 1px solid rgba(185,61,50,.22); background: #fff3ef; }.board-label { color: #245d7c; font-size: .68rem; font-weight: 900; letter-spacing: .09em; text-transform: uppercase; }.fixed-pairs p { display: flex; justify-content: space-between; align-items: center; gap: .75rem; margin: 1.1rem 0 .35rem; }.fixed-pairs s { color: #754a43; font: 850 1.15rem ui-monospace, monospace; }.fixed-pairs b { display: grid; width: 2rem; height: 2rem; place-items: center; border-radius: .65rem; background: #b83d32; color: #fff; }.fixed-pairs small { color: #754a43; }.token-demo { background: #172c3a; color: #fff; }.token-demo .board-label { color: #8fd5e9; }.token-demo > div { display: flex; flex-wrap: wrap; gap: .35rem; margin: .85rem 0 .55rem; }.token-demo i { padding: .45rem .6rem; border: 1px solid rgba(255,255,255,.18); border-radius: .55rem; background: rgba(255,255,255,.1); color: #fff; font: normal 800 .9rem ui-monospace, monospace; }.token-demo small { color: #dce6e8; }.token-facts { display: grid; grid-template-columns: repeat(3,1fr); gap: .65rem; margin-top: .7rem; }.token-facts p { display: grid; gap: .15rem; margin: 0; padding: .65rem .8rem; border: 1px solid rgba(32,48,43,.1); border-radius: .8rem; background: rgba(255,255,255,.72); }.token-facts span { color: #65716d; font-size: .78rem; }
  .budget { display: flex; min-height: 4rem; margin-top: 1rem; overflow: hidden; border-radius: 1rem; }.budget div { display: grid; place-items: center; padding: .5rem; color: #172c3a; font-size: .72rem; font-weight: 900; text-align: center; }.rules{width:15%;background:#c4b5fd}.chat{width:23%;background:#9bd8ea}.files{width:34%;background:#9ed7b5}.tools{width:18%;background:#f5c45f}.output{width:10%;background:#ef9a86}.caption { display: block; margin-top: .4rem; color: #65716d; }
  .position-card { display: grid; grid-template-columns: 1.1fr .9fr; gap: 1.5rem; align-items: center; padding: clamp(1rem, 3vw, 1.6rem); border: 1px solid rgba(47,113,150,.2); border-radius: 1.4rem; background: #f4f9fa; }.curve { padding: .5rem; border-radius: 1rem; background: #fff; }.curve svg { display: block; width: 100%; height: auto; }.curve .axis { fill: none; stroke: #ccd8d4; stroke-width: 2; }.curve .line { fill: none; stroke: #2f7196; stroke-width: 8; stroke-linecap: round; }.curve circle { fill: #6941a5; }.curve circle.risk { fill: #c9573f; }.curve text { fill: #52615c; font-size: 15px; }.position-card h3 { margin: 0; font-size: 1.5rem; }.position-card p, .position-card li { color: #51605a; }.practice-label { display: block; margin-top: .75rem; color: #245d7c; font-size: .76rem; letter-spacing: .06em; text-transform: uppercase; }.caveat { padding: .7rem .8rem; border-radius: .8rem; background: #fff3d6; }.source { color: #65716d; font-size: .83rem; }.source a { color: #245d7c; font-weight: 800; }
  .rot-board { display: grid; grid-template-columns: repeat(3,1fr); gap: .7rem; }.rot-board article { padding: .9rem; border: 1px solid rgba(47,113,150,.17); border-radius: 1.1rem; background: #f7faf9; }.rot-stage { display: block; color: #245d7c; font-size: .7rem; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; }.signal-field { display: flex; flex-wrap: wrap; gap: .32rem; align-content: center; min-height: 7.2rem; margin: .65rem 0; padding: .7rem; border-radius: .85rem; background: #fff; }.signal-field b,.signal-field em,.signal-field i { min-height: 1.6rem; border-radius: .45rem; }.signal-field b,.signal-field em { display: inline-flex; align-items: center; padding: .25rem .45rem; font-size: .7rem; font-style: normal; }.signal-field b { background: #d9f0e4; color: #145c49; }.signal-field em { background: #ffe0d7; color: #913527; }.signal-field i { width: 2.4rem; background: #e5ece9; }.rot-board p { margin: 0; font-size: .85rem; }.problem-compare { display: grid; grid-template-columns: 1fr 1fr; gap: .65rem; margin-top: .75rem; }.problem-compare p { display: grid; gap: .18rem; margin: 0; padding: .7rem .85rem; border-radius: .85rem; background: #edf6fa; }.problem-compare span { color: #51605a; font-size: .82rem; }
  .compact-strategy { display: grid; grid-template-columns: repeat(4,1fr); gap: .65rem; }.compact-strategy article { min-height: 10rem; padding: .9rem; border: 1px solid rgba(32,48,43,.14); border-radius: 1rem; background: #fff; }.compact-strategy h3 { margin: .55rem 0 .25rem; font-size: 1rem; }.compact-strategy p { margin: 0; font-size: .82rem; }.strategy-icon { display: grid; width: 2.35rem; height: 2.35rem; place-items: center; border-radius: .7rem; font-size: 1.2rem; font-weight: 900; }.strategy-icon.exact { background: #e6def6; color: #5c358f; }.strategy-icon.summary { background: #dff0f6; color: #245d7c; }.strategy-icon.discard { background: #ffe0d7; color: #913527; }.strategy-icon.retrieve { background: #def1e7; color: #145c49; }.loss-demo { display: grid; grid-template-columns: 1fr auto 1fr; gap: .65rem; align-items: center; margin-top: .75rem; }.loss-demo article { min-height: 6.5rem; padding: .8rem 1rem; border-radius: .9rem; background: #f4f7f6; }.loss-demo article > span { color: #245d7c; font-size: .68rem; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; }.loss-demo p { margin: .45rem 0 0; }.loss-demo mark { padding: .05rem .18rem; background: #ffe2a8; color: inherit; }.loss-demo small { display: block; margin-top: .35rem; color: #913527; }.loss-demo > span { color: #245d7c; font-size: 1.3rem; font-weight: 900; }
  .model-windows { display: grid; gap: .5rem; }.model-windows > span { display: flex; justify-content: space-between; gap: 1rem; padding: .7rem .8rem; border-radius: .8rem; background: rgba(47,113,150,.07); }.model-windows small { text-align: right; }
  .quick-check { margin: clamp(3rem, 8vw, 6rem) 0 2rem; padding: clamp(1.3rem, 4vw, 2.4rem); border-radius: 1.5rem; background: #172c3a; color: #fff; }.quick-check .step { color: #8fd5e9; }.quick-check h2 { margin-bottom: 0; }.quick-check strong { color: #f5c45f; }
  .level-actions { display: flex; justify-content: space-between; gap: 1rem; margin-top: 1.5rem; }.level-actions a { color: #375249; font-weight: 850; }.level-actions .map-link { margin-inline: auto; }.level-actions .next { color: #245d7c; }a:focus-visible { outline: 3px solid #d99a1e; outline-offset: 4px; }
  :global(body.is-presenting) .session-context article { min-height: 10.5rem; }:global(body.is-presenting) .token-board>* { min-height: 8.8rem; }:global(body.is-presenting) .signal-field { min-height: 5.5rem; }:global(body.is-presenting) .compact-strategy article { min-height: 8.4rem; }
  @media(max-width:760px){.session-context,.token-board,.token-facts,.rot-board,.problem-compare,.compact-strategy,.loss-demo{grid-template-columns:1fr}.request-bridge{max-width:none}.request-bridge>span,.session-context>.arrow,.loss-demo>span{rotate:90deg;text-align:center}.session-items{grid-template-columns:1fr}.position-card{grid-template-columns:1fr}.budget{flex-direction:column}.budget div{width:100%!important;min-height:2.5rem}.model-windows>span{display:grid}.model-windows small{text-align:left}.level-actions{flex-direction:column}}
</style>
