---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LevelHero from "../../components/LevelHero.astro";
import FieldNote from "../../components/FieldNote.astro";
import AgentLoop from "../../components/AgentLoop.astro";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const href = (path: string) => `${base.replace(/\/?$/, "/")}${path}`;
---

<BaseLayout title="T1 · Anatomía de un agente" description="Modelo, tools, ciclo, harness, instrucciones, skills, guardrails y MCP sin confundir sus responsabilidades." current="parte-2" theme="technical">
  <main id="contenido" class="tech-level">
    <LevelHero eyebrow="Parte 2 · Nivel técnico 1" title="Anatomía de un agente" intro="Abrimos el sistema para separar quién propone, quién ejecuta y quién organiza los límites." dino="roco" dinoLabel="Roco abre el tablero del laboratorio" guide="Seguimos una misión: leer un PDF, detectar tres riesgos y guardar un resumen." tone="technical">
      <div slot="actions" class="hero-actions"><a href="#agente">Abrir el sistema ↓</a><a href={href("#mapa")}>Mapa de la expedición</a></div>
    </LevelHero>

    <section id="agente" class="visual-section" aria-labelledby="agente-title">
      <header><span class="step">01 · La idea completa</span><h2 id="agente-title">¿Cuándo un sistema actúa como agente?</h2></header>
      <div class="definition-board">
        <article class="single-turn"><span class="concept-mark" aria-hidden="true">◇</span><div><p class="concept-label">Una salida</p><h3>El modelo responde</h3><p>Recibe contexto y produce texto, datos o una propuesta de acción.</p></div></article>
        <span class="versus" aria-hidden="true">≠</span>
        <article class="agent-system"><span class="concept-mark" aria-hidden="true">↺</span><div><p class="concept-label">Un ciclo</p><h3>El agente continúa</h3><p>Conserva el objetivo, actúa, observa evidencia y decide el próximo paso.</p></div></article>
      </div>
      <p class="definition"><b>Agente = el comportamiento del sistema completo en funcionamiento.</b> No es simplemente otro nombre para el modelo.</p>
    </section>

    <section id="piezas" class="visual-section" aria-labelledby="piezas-title">
      <header><span class="step">02 · Dos trabajos distintos</span><h2 id="piezas-title">Proponer no es ejecutar</h2><p>En nuestra misión, alguien debe decidir leer el PDF y algo debe abrirlo de verdad.</p></header>
      <div class="compare pieces-compare">
        <article class="model-card"><span class="tag violet">Modelo · propone</span><h3>“Necesito leer el informe”</h3><p>Genera la próxima salida o solicita usar una herramienta.</p><code>próximo paso → leer_archivo</code></article>
        <article class="tool-card"><span class="tag teal">Tool · ejecuta</span><h3>Abre el PDF</h3><p>Realiza una operación acotada y devuelve el contenido.</p><code>leer_archivo("informe.pdf")</code></article>
      </div>
      <p class="truth"><b>El modelo no se da permisos a sí mismo.</b> Puede proponer una acción; el entorno decide si la tool existe, si está autorizada o si necesita aprobación.</p>
    </section>

    <section id="ciclo" class="visual-section" aria-labelledby="ciclo-title">
      <header><span class="step">03 · La misión en movimiento</span><h2 id="ciclo-title">El agente avanza con evidencia</h2></header>
      <AgentLoop />
    </section>

    <section id="harness" class="visual-section" aria-labelledby="harness-title">
      <header><span class="step">04 · La mesa de trabajo</span><h2 id="harness-title">El harness organiza y limita</h2><p>No “piensa” por el modelo. Prepara y controla el entorno donde ocurre el ciclo.</p></header>
      <div class="harness-board">
        <div class="harness-core"><span aria-hidden="true">⚙</span><strong>Harness</strong><small>mantiene la expedición en marcha</small></div>
        <div class="satellite"><b>Contexto</b><span>qué recibe el modelo</span></div><div class="satellite"><b>Estado</b><span>qué ocurrió hasta ahora</span></div><div class="satellite"><b>Tools</b><span>qué acciones están disponibles</span></div><div class="satellite"><b>Permisos</b><span>qué puede ejecutarse</span></div>
      </div>
      <div class="client-row" role="group" aria-label="Ejemplos de clientes"><div><span aria-hidden="true">▣</span><b>Web</b><small>conversación y servicios</small></div><div><span aria-hidden="true">◫</span><b>Desktop</b><small>archivos y sistema local</small></div><div><span aria-hidden="true">›_</span><b>Terminal</b><small>repositorios y comandos</small></div></div>
      <p class="under-note">El mismo modelo puede sentirse distinto: cada cliente lo rodea con otro harness, otras tools y otros permisos.</p>
    </section>

    <section id="reglas" class="visual-section" aria-labelledby="reglas-title">
      <header><span class="step">05 · Métodos y límites</span><h2 id="reglas-title">No todo lo que guía es un guardrail</h2></header>
      <div class="guidance-grid">
        <article><span class="piece-icon sky" aria-hidden="true">→</span><h3>Instrucción</h3><p>Indica qué debe hacer o respetar.</p><small>“Entregá tres riesgos con evidencia.”</small></article>
        <article><span class="piece-icon violet" aria-hidden="true">◇</span><h3>Skill</h3><p>Aporta un método reutilizable.</p><small>Cómo revisar un PDF o preparar un informe.</small></article>
        <article><span class="piece-icon amber" aria-hidden="true">▣</span><h3>Guardrail</h3><p>Reduce lo permitido o exige una condición.</p><small>No publicar sin aprobación humana.</small></article>
      </div>
      <FieldNote summary="Guardrail blando frente a guardrail duro" variant="warning"><div class="note-grid"><p><b>Blando:</b> es una instrucción dentro del contexto. Depende de que el modelo la siga.</p><p><b>Duro:</b> vive fuera del modelo: sandbox, permiso denegado, esquema obligatorio o aprobación humana.</p></div></FieldNote>
    </section>

    <section id="mcp" class="visual-section" aria-labelledby="mcp-title">
      <header><span class="step">06 · El puente</span><h2 id="mcp-title">MCP conecta. No piensa.</h2><p>Distintos productos necesitan una forma común de descubrir herramientas y entender cómo usarlas.</p></header>
      <div class="mcp-bridge" role="group" aria-label="Conexión mediante MCP"><article><span>Producto o host</span><strong>Harness + cliente MCP</strong><small>solicita capacidades externas</small></article><div class="bridge-protocol"><span aria-hidden="true">⇄</span><b>MCP</b><small>protocolo</small></div><article><span>Servidor MCP</span><strong>Tools + recursos + prompts</strong><small>publica capacidades compatibles</small></article></div>
      <ul class="not-list" aria-label="Qué no es MCP"><li>No es un modelo</li><li>No es un agente</li><li>No conserva el objetivo global</li></ul>
      <FieldNote summary="Excavar más · ¿Dónde viven las instrucciones y las skills?" variant="technical"><p>No existe una ubicación universal. Pueden estar versionadas en el repositorio —por ejemplo <code>AGENTS.md</code>, <code>CLAUDE.md</code> o carpetas de skills—, en la configuración personal o incluidas por el producto.</p><p>Esos archivos configuran el harness. Una carpeta no convierte por sí sola un archivo en skill o guardrail: depende de cómo el producto lo carga y qué prioridad le da.</p></FieldNote>
    </section>

    <section class="quick-check" aria-labelledby="check-title">
      <div><span class="step">07 · Armá el sistema</span><h2 id="check-title">Una misión, un sistema completo</h2></div>
      <div class="system-flow" role="group" aria-label="Persona, harness, modelo, herramientas y resultado"><span>Persona</span><i aria-hidden="true">→</i><span>Harness</span><i aria-hidden="true">→</i><span>Modelo</span><i aria-hidden="true">↔</i><span>Tools</span><i aria-hidden="true">→</i><span>Resultado</span></div>
      <div class="exit-questions"><p><b>¿Quién propone?</b><span>Modelo</span></p><p><b>¿Quién ejecuta?</b><span>Tool</span></p><p><b>¿Quién conserva estado, arma contexto y aplica permisos?</b><span>Harness</span></p></div>
      <strong>Si el sistema mantiene el objetivo y decide cómo continuar, estás viendo comportamiento de agente.</strong>
    </section>

    <nav class="level-actions" aria-label="Navegación del recorrido técnico"><a href={href("parte-1/juegos/")}>← Juegos de la Parte 1</a><a class="map-link" href={href("#mapa")}>Mapa</a><a class="next" href={href("parte-2/nivel-2/")}>Siguiente: la mochila de contexto →</a></nav>
  </main>
</BaseLayout>

<style>
  .tech-level { width: min(1100px, calc(100% - 2rem)); margin: 0 auto; padding-bottom: 5rem; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .65rem; }
  .hero-actions a { min-height: 2.75rem; display: inline-flex; align-items: center; padding: .65rem .9rem; border-radius: .8rem; background: #fff; color: #20302b; text-decoration: none; font-weight: 850; }
  .visual-section { padding: clamp(3rem, 8vw, 6.5rem) 0 0; scroll-margin-top: 6rem; }
  .visual-section > header { max-width: 800px; margin-bottom: 1.25rem; }
  .step { display: block; color: #5c358f; font-size: .75rem; font-weight: 900; letter-spacing: .11em; text-transform: uppercase; }
  h2 { margin: .35rem 0 .6rem; font-size: clamp(2rem, 5vw, 4rem); line-height: 1; letter-spacing: -.035em; }
  h3 { margin: .5rem 0 .3rem; }
  header p, article p, .under-note { color: #51605a; }
  article p { margin: 0; }
  .definition-board { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; align-items: stretch; }
  .definition-board article { display: grid; grid-template-columns: auto 1fr; gap: 1rem; align-items: center; min-height: 190px; padding: clamp(1.25rem, 3vw, 2rem); border-radius: 1.5rem; }
  .single-turn { border: 1px solid rgb(47 113 150 / 28%); background: #edf6fa; }
  .agent-system { border: 1px solid rgb(105 65 165 / 30%); background: #f2edfb; }
  .concept-mark { display: grid; width: 3.8rem; height: 3.8rem; place-items: center; border-radius: 1.2rem; background: #fff; color: #5c358f; font-size: 2rem; font-weight: 900; }
  .concept-label { color: #5c358f; font-size: .72rem; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; }
  .versus { align-self: center; color: #d99a1e; font-size: 2rem; font-weight: 950; }
  .definition { margin: 1rem 0 0; padding: 1rem 1.15rem; border-left: 4px solid #6941a5; border-radius: 0 1rem 1rem 0; background: #fff; color: #4f5d58; }
  .compare { display: grid; grid-template-columns: 1fr 1fr; gap: .8rem; }
  .pieces-compare article { display: grid; align-content: start; gap: .55rem; min-height: 250px; padding: 1.5rem; border-radius: 1.3rem; }
  .model-card { border: 1px solid rgb(105 65 165 / 28%); background: #f1ecfb; }
  .tool-card { border: 1px solid rgb(23 107 85 / 25%); background: #e8f5ef; }
  .tag { justify-self: start; display: inline-flex; padding: .4rem .55rem; border-radius: 999px; font-size: .75rem; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; }
  .tag.violet { background: #ded0f5; color: #4e287f; }
  .tag.teal { background: #ccebdc; color: #145c49; }
  code { justify-self: start; margin-top: .35rem; padding: .4rem .55rem; border-radius: .55rem; background: rgb(32 48 43 / 8%); color: #20302b; }
  .truth { margin: 1rem 0 0; padding: 1rem 1.15rem; border-left: 4px solid #d99a1e; border-radius: 0 1rem 1rem 0; background: #fff7e5; color: #4f5d58; }
  .under-note { margin: 1rem 0 0; text-align: center; }
  .harness-board { display: grid; grid-template-columns: repeat(4, 1fr); gap: .7rem; padding: 1rem; border: 1px solid rgb(105 65 165 / 22%); border-radius: 1.5rem; background: #f4f0fb; }
  .harness-core { grid-column: 1 / -1; justify-self: center; min-width: min(330px, 100%); display: grid; justify-items: center; gap: .15rem; padding: 1rem; border-radius: 1rem; background: #20302b; color: #fff; }
  .harness-core > span { font-size: 1.4rem; }
  .harness-core small { color: #dce5e1; }
  .satellite { display: grid; gap: .2rem; padding: 1rem; border-radius: 1rem; background: #fff; text-align: center; }
  .satellite span { color: #51605a; font-size: .82rem; }
  .client-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: .7rem; margin-top: .8rem; }
  .client-row div { display: grid; grid-template-columns: auto 1fr; gap: .15rem .65rem; align-items: center; padding: 1rem; border: 1px solid rgb(32 48 43 / 14%); border-radius: 1rem; background: rgb(255 255 255 / 72%); }
  .client-row div > span { grid-row: span 2; color: #6941a5; font: 900 1.3rem ui-monospace, monospace; }
  .client-row small { color: #51605a; }
  .guidance-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: .8rem; }
  .guidance-grid article { padding: 1.25rem; border: 1px solid rgb(32 48 43 / 14%); border-radius: 1.2rem; background: rgb(255 255 255 / 76%); }
  .guidance-grid small { display: block; margin-top: .75rem; padding-top: .75rem; border-top: 1px dashed rgb(32 48 43 / 20%); color: #51605a; }
  .piece-icon { display: grid; width: 2.8rem; height: 2.8rem; place-items: center; border-radius: .9rem; font-size: 1.25rem; }
  .piece-icon.sky { background: #e1f1f7; color: #245d7c; }
  .piece-icon.violet { background: #eee8fa; color: #5c358f; }
  .piece-icon.amber { background: #fff0cc; color: #714c00; }
  .note-grid { display: grid; grid-template-columns: 1fr 1fr; gap: .75rem; }
  .note-grid p { margin: 0; }
  .mcp-bridge { display: grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; align-items: center; padding: clamp(1rem, 3vw, 1.6rem); border: 1px solid rgb(47 113 150 / 25%); border-radius: 1.5rem; background: #edf6fa; }
  .mcp-bridge article { display: grid; gap: .25rem; min-height: 150px; align-content: center; padding: 1.2rem; border-radius: 1.1rem; background: #fff; text-align: center; }
  .mcp-bridge article span { color: #5c358f; font-size: .72rem; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; }
  .mcp-bridge article strong { font-size: 1.2rem; }
  .mcp-bridge article small { color: #51605a; }
  .bridge-protocol { display: grid; min-width: 100px; justify-items: center; gap: .1rem; color: #245d7c; }
  .bridge-protocol span { font-size: 2.3rem; }
  .bridge-protocol b { font-size: 1.25rem; }
  .not-list { display: flex; flex-wrap: wrap; justify-content: center; gap: .6rem; margin: 1rem 0; padding: 0; list-style: none; }
  .not-list li { padding: .5rem .7rem; border-radius: 999px; background: #fff0cc; color: #714c00; font-size: .82rem; font-weight: 850; }
  .quick-check { margin: clamp(3rem, 8vw, 6rem) 0 2rem; padding: clamp(1.3rem, 4vw, 2.4rem); border-radius: 1.5rem; background: #172c3a; color: #fff; }
  .quick-check .step { color: #f5c45f; }
  .quick-check h2 { max-width: 22ch; }
  .system-flow { display: flex; flex-wrap: wrap; align-items: center; gap: .45rem; margin: 1.25rem 0; }
  .system-flow span { padding: .55rem .7rem; border-radius: .7rem; background: rgb(255 255 255 / 12%); font-weight: 850; }
  .system-flow i { color: #8fd5e9; font-style: normal; font-weight: 900; }
  .exit-questions { display: grid; grid-template-columns: repeat(3, 1fr); gap: .7rem; margin-bottom: 1.2rem; }
  .exit-questions p { display: grid; gap: .25rem; margin: 0; padding: 1rem; border-radius: 1rem; background: rgb(255 255 255 / 8%); }
  .exit-questions b { color: #dce6e8; }
  .exit-questions span, .quick-check > strong { color: #9fe0ca; }
  .quick-check > strong { display: block; font-size: clamp(1.1rem, 2.4vw, 1.55rem); }
  .level-actions { display: flex; justify-content: space-between; gap: 1rem; margin-top: 1.5rem; }
  .level-actions a { color: #375249; font-weight: 850; }
  .level-actions .map-link { margin-inline: auto; }
  .level-actions .next { color: #5c358f; }
  a:focus-visible { outline: 3px solid #d99a1e; outline-offset: 4px; }
  :global(body.is-presenting) #ciclo > header { margin-bottom: .35rem; }
  :global(body.is-presenting) #ciclo h2 { font-size: clamp(2.35rem, 4vw, 3.4rem); }
  @media (max-width: 760px) {
    .definition-board, .compare, .harness-board, .client-row, .guidance-grid, .mcp-bridge, .note-grid, .exit-questions { grid-template-columns: 1fr; }
    .versus { justify-self: center; }
    .harness-core { grid-column: auto; }
    .bridge-protocol { min-width: 0; }
    .bridge-protocol span { rotate: 90deg; }
    .level-actions { flex-direction: column; }
  }
</style>
