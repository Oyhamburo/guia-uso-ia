---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LevelHero from "../../components/LevelHero.astro";
import FieldNote from "../../components/FieldNote.astro";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const href = (path: string) => `${base.replace(/\/?$/, "/")}${path}`;
---

<BaseLayout title="T3 · Trabajo confiable con IA" description="Alcance, evidencia, documentación y testing para trabajar con IA sin perder control." current="parte-2" theme="technical">
  <main id="contenido" class="tech-level">
    <LevelHero eyebrow="Parte 2 · Nivel técnico 3" title="Trabajo confiable con IA" intro="No existe una cantidad correcta de autonomía. El flujo útil depende de lo que sabés, el riesgo y cuánto resultado podés revisar responsablemente." dino="vera" dinoLabel="Vera sigue cada huella hasta la evidencia" guide="La velocidad sólo sirve si aumenta la confianza." tone="coral">
      <div slot="actions" class="hero-actions"><a href="#cuello">Ver el cuello de botella ↓</a><a href={href("#mapa")}>Mapa de la expedición</a></div>
    </LevelHero>

    <section class="visual-section" aria-labelledby="formula-title">
      <header><span class="step">01 · Tu punto de partida</span><h2 id="formula-title">La forma de trabajar se diseña</h2></header>
      <div class="formula" aria-label="Tu conocimiento más tipo de tarea más riesgo aceptable da como resultado tu forma de trabajar"><span>Lo que entendés</span><b>+</b><span>Tipo de tarea</span><b>+</b><span>Riesgo aceptable</span><b>=</b><span class="result">Tu flujo</span></div>
      <p class="truth"><b>No es una escala de madurez.</b> Usar un chat manualmente no es peor que usar un agente. La modalidad correcta es la que conserva comprensión y responsabilidad.</p>
    </section>

    <section id="cuello" class="visual-section" aria-labelledby="bottle-title">
      <header><span class="step">02 · El cuello de botella cambió</span><h2 id="bottle-title">Generar se volvió barato.<br>Verificar sigue siendo caro.</h2><p>Un agente produce código, documentos y decisiones en minutos. Entender efectos secundarios y asumir consecuencias sigue llevando tiempo.</p></header>
      <div class="speed-card"><div><span>Producción con IA</span><i class="fast"></i></div><div><span>Revisión responsable</span><i class="slow"></i></div></div>
      <div class="problem-grid">
        <article><span>Contexto</span><h3>Resuelve otro problema</h3><p>No ve historia o restricciones que nunca recibió.</p><small>Señal: la solución es buena para una versión incompleta.</small></article>
        <article><span>Probabilidad</span><h3>Parece terminado</h3><p>Una explicación convincente no demuestra funcionamiento.</p><small>Señal: toda la evidencia viene del mismo agente.</small></article>
        <article><span>Volumen</span><h3>Supera tu revisión</h3><p>El diff crece más rápido que tu comprensión.</p><small>Señal: no podés explicar el cambio completo.</small></article>
        <article><span>Continuidad</span><h3>Pierde decisiones</h3><p>Compactación o sesiones nuevas retiran detalles.</p><small>Señal: vuelve a debatir algo ya resuelto.</small></article>
        <article><span>Acciones</span><h3>El error sale del chat</h3><p>Con tools autorizadas puede modificar sistemas reales.</p><small>Señal: una propuesta se convierte en efecto.</small></article>
        <article><span>Responsabilidad</span><h3>Nadie cierra</h3><p>El modelo no asume el costo técnico o humano.</p><small>Señal: nadie puede decir quién validó.</small></article>
      </div>
    </section>

    <section class="visual-section" aria-labelledby="loop-title">
      <header><span class="step">03 · El ciclo seguro</span><h2 id="loop-title">Cuatro pasos que conservan control</h2></header>
      <ol class="safe-loop">
        <li><span>1</span><div><b>Acotar</b><small>objetivo pequeño + restricciones + aceptación</small></div></li>
        <li><span>2</span><div><b>Observar</b><small>plan, archivos elegidos y supuestos</small></div></li>
        <li><span>3</span><div><b>Exigir evidencia</b><small>diff, tests, comandos y resultados</small></div></li>
        <li><span>4</span><div><b>Decidir</b><small>aceptar, corregir, reducir o descartar</small></div></li>
      </ol>
    </section>

    <section class="visual-section" aria-labelledby="phases-title">
      <header><span class="step">04 · Separá incertidumbre de ejecución</span><h2 id="phases-title">Un artefacto puede unir sesiones</h2><p>En tareas no triviales, investigar, decidir, ejecutar y verificar son trabajos distintos. No siempre necesitan sesiones separadas; sí necesitan límites visibles.</p></header>
      <div class="phase-track">
        <article><span>Sesión o fase 1</span><h3>Investigar</h3><p>Explorar, entender restricciones y comparar caminos sin editar por reflejo.</p></article><b aria-hidden="true">→</b>
        <article class="bridge"><span>Puente</span><h3>Dejar un plan</h3><p>Objetivo, alcance, decisiones, riesgos y aceptación.</p></article><b aria-hidden="true">→</b>
        <article><span>Sesión o fase 2</span><h3>Ejecutar</h3><p>Empezar con el problema ordenado y la información importante cerca.</p></article><b aria-hidden="true">→</b>
        <article><span>Opcional</span><h3>Verificar</h3><p>Mirada nueva, pruebas definidas y criterio de cierre.</p></article>
      </div>
      <p class="truth warning"><b>Congelá la pregunta durante las pruebas.</b> Registrá hallazgos fuera de alcance, pero no dejes que arrastren la tarea original sin una decisión consciente.</p>
    </section>

    <section class="visual-section" aria-labelledby="docs-title">
      <header><span class="step">05 · Rama para software</span><h2 id="docs-title">Documentá antes de pedir autonomía</h2><p>Un modelo puede inferir el lenguaje mirando código. No puede inferir con seguridad tus convenciones, experiencias ni requisitos de producto.</p></header>
      <div class="docs-grid">
        <article><code>README.md</code><p>Qué hace el proyecto y cómo levantarlo.</p></article>
        <article><code>AGENTS.md</code><p>Cómo debe trabajar una IA en el repositorio.</p></article>
        <article><code>ARCHITECTURE.md</code><p>Componentes, límites, flujo e invariantes.</p></article>
        <article><code>TESTING.md</code><p>Comandos, fixtures y evidencia esperada.</p></article>
        <article><code>DEPLOYMENT.md</code><p>Entornos, migraciones, rollback y aprobaciones.</p></article>
        <article><code>SECURITY.md</code><p>Secretos, permisos y acciones prohibidas.</p></article>
        <article><code>CONTRIBUTING.md</code><p>Ramas, commits, PRs y acuerdos del equipo.</p></article>
        <article><code>docs/decisions/</code><p>Qué se eligió, por qué y con qué consecuencias.</p></article>
      </div>
      <FieldNote summary="Fuente canónica, sin documentación de relleno" variant="note">
        <p>Los documentos neutrales viven con el proyecto. Configuraciones específicas de una herramienta pueden enlazarlos o resumirlos, pero no deberían guardar la única copia del conocimiento importante. Si dos archivos repiten o contradicen información, unilos. Cargá sólo lo relevante para la tarea.</p>
        <p><b>No asumas descubrimiento automático:</b> cada producto decide si busca <code>AGENTS.md</code>, <code>CLAUDE.md</code> u otro archivo, desde qué ubicación y con qué alcance. Comprobalo en la herramienta que uses o pedí explícitamente que lea la fuente necesaria.</p>
      </FieldNote>
      <FieldNote summary="La documentación orienta; no controla" variant="warning">
        <p><code>AGENTS.md</code> y <code>SECURITY.md</code> son instrucciones. No reemplazan permisos técnicos, sandbox, políticas de CI, secret managers ni aprobaciones implementadas fuera del modelo.</p>
      </FieldNote>
    </section>

    <section class="visual-section" aria-labelledby="testing-title">
      <header><span class="step">06 · Subí la vara</span><h2 id="testing-title">Si la IA genera más rápido, probá mejor</h2></header>
      <div class="testing-grid">
        <article><span>Falla primero</span><h3>Bug reproducible</h3><p>Idealmente el test falla antes de la corrección y pasa después.</p></article>
        <article><span>Receipt</span><h3>Comando real</h3><p>Guardá test, lint o build y su resultado exacto. “Debería pasar” no es evidencia.</p></article>
        <article><span>Nivel justo</span><h3>Prueba apropiada</h3><p>Unitario para lógica, integración para límites, E2E para recorridos críticos.</p></article>
        <article><span>Independencia</span><h3>Esperado fundado</h3><p>Anclá tests en requisitos, contratos, fixtures o comportamiento existente.</p></article>
        <article><span>Calidad</span><h3>Aserciones útiles</h3><p>Casos negativos, bordes y pruebas determinísticas importan más que un porcentaje.</p></article>
        <article><span>Red de seguridad</span><h3>No la aflojes</h3><p>Desconfiá de sobre-mocking o de borrar tests sólo para lograr verde.</p></article>
      </div>
      <div class="done"><span aria-hidden="true">✓</span><p><b>Definición de terminado:</b> el comportamiento esperado está probado en el nivel correcto, los comandos relevantes fueron ejecutados y una persona puede explicar por qué esa evidencia alcanza.</p></div>
    </section>

    <section class="quick-check"><span class="step">Pregunta del nivel</span><h2>¿Podés revisar el resultado con la misma responsabilidad con la que lo vas a aceptar?</h2><p>Si la respuesta es no, reducí el alcance antes de producir más.</p></section>

    <nav class="level-actions" aria-label="Navegación del recorrido técnico"><a href={href("parte-2/nivel-2/")}>← La mochila de contexto</a><a class="map-link" href={href("#mapa")}>Mapa</a><a class="next" href={href("parte-2/preguntas/")}>Completar con preguntas →</a></nav>
  </main>
</BaseLayout>

<style>
  .tech-level{width:min(1100px,calc(100% - 2rem));margin:0 auto;padding-bottom:5rem}.hero-actions{display:flex;flex-wrap:wrap;gap:.65rem}.hero-actions a{min-height:2.75rem;display:inline-flex;align-items:center;padding:.65rem .9rem;border-radius:.8rem;background:#fff;color:#20302b;text-decoration:none;font-weight:850}.visual-section{padding:clamp(3rem,8vw,6.5rem) 0 0;scroll-margin-top:6rem}.visual-section>header{max-width:820px;margin-bottom:1.25rem}.step{display:block;color:#99412f;font-size:.75rem;font-weight:900;letter-spacing:.11em;text-transform:uppercase}h2{margin:.35rem 0 .6rem;font-size:clamp(2rem,5vw,4rem);line-height:1;letter-spacing:-.035em}header p,article p{color:#51605a}
  .formula{display:grid;grid-template-columns:repeat(7,auto);gap:.65rem;align-items:center;justify-content:center;padding:1.25rem;border:1px solid rgba(32,48,43,.14);border-radius:1.25rem;background:#fff}.formula span{padding:.75rem .9rem;border-radius:.8rem;background:#f0f4f2;font-weight:800;text-align:center}.formula b{color:#99412f}.formula .result{background:#fee8e1;color:#7c2f20}.truth{margin:1rem 0 0;padding:1rem 1.15rem;border-left:4px solid #c9573f;border-radius:0 1rem 1rem 0;background:#fff0ec;color:#4f5d58}.truth.warning{border-color:#d99a1e;background:#fff7e5}
  .speed-card{display:grid;gap:.8rem;padding:1.15rem;border-radius:1.2rem;background:#172c3a;color:#fff}.speed-card>div{display:grid;grid-template-columns:160px 1fr;gap:1rem;align-items:center}.speed-card i{display:block;height:.8rem;border-radius:999px}.speed-card .fast{width:95%;background:linear-gradient(90deg,#7ad7c0,#b9a1eb)}.speed-card .slow{width:36%;background:#f5c45f}
  .problem-grid,.testing-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:.75rem;margin-top:1rem}.problem-grid article,.testing-grid article{padding:1.1rem;border:1px solid rgba(32,48,43,.14);border-radius:1.1rem;background:#fff}.problem-grid article>span,.testing-grid article>span{color:#99412f;font-size:.72rem;font-weight:900;letter-spacing:.08em;text-transform:uppercase}.problem-grid h3,.testing-grid h3{margin:.45rem 0 .25rem}.problem-grid p,.testing-grid p{margin:0}.problem-grid small{display:block;margin-top:.7rem;color:#9b3f30;font-weight:750}
  .safe-loop{display:grid;grid-template-columns:repeat(4,1fr);gap:.7rem;margin:0;padding:0;list-style:none}.safe-loop li{display:grid;grid-template-columns:auto 1fr;gap:.65rem;padding:1rem;border:1px solid rgba(23,107,85,.22);border-radius:1rem;background:#eaf7f1}.safe-loop li>span{display:grid;place-items:center;width:2rem;height:2rem;border-radius:.65rem;background:#176b55;color:#fff;font-weight:900}.safe-loop b,.safe-loop small{display:block}.safe-loop small{margin-top:.2rem;color:#51605a}
  .phase-track{display:grid;grid-template-columns:1fr auto 1fr auto 1fr auto 1fr;gap:.55rem;align-items:stretch}.phase-track article{padding:1rem;border:1px solid rgba(32,48,43,.14);border-radius:1rem;background:#fff}.phase-track .bridge{border-color:rgba(217,154,30,.38);background:#fff8e8}.phase-track> b{display:grid;place-items:center;color:#c9573f}.phase-track article>span{color:#99412f;font-size:.7rem;font-weight:900;text-transform:uppercase}.phase-track h3{margin:.35rem 0}.phase-track p{margin:0;font-size:.9rem}
  .docs-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:.65rem}.docs-grid article{padding:1rem;border:1px solid rgba(32,48,43,.14);border-radius:1rem;background:#fff}.docs-grid code{display:inline-block;color:#5c358f;font-size:.83rem;font-weight:900}.docs-grid p{margin:.45rem 0 0;font-size:.88rem}.testing-grid article>span{color:#176b55}.done{display:grid;grid-template-columns:auto 1fr;gap:.8rem;align-items:center;margin-top:.9rem;padding:1rem 1.15rem;border-radius:1rem;background:#dff3e9}.done>span{display:grid;place-items:center;width:2.4rem;height:2.4rem;border-radius:.75rem;background:#176b55;color:#fff;font-weight:900}.done p{margin:0;color:#375249}
  .quick-check{margin:clamp(3rem,8vw,6rem) 0 2rem;padding:clamp(1.3rem,4vw,2.4rem);border-radius:1.5rem;background:#172c3a;color:#fff}.quick-check .step{color:#f4a38f}.quick-check h2{max-width:25ch}.quick-check p{color:#dce6e8;font-size:1.05rem}.level-actions{display:flex;justify-content:space-between;gap:1rem;margin-top:1.5rem}.level-actions a{color:#375249;font-weight:850}.level-actions .map-link{margin-inline:auto}.level-actions .next{color:#99412f}a:focus-visible{outline:3px solid #d99a1e;outline-offset:4px}
  @media(max-width:900px){.problem-grid,.testing-grid{grid-template-columns:1fr 1fr}.docs-grid{grid-template-columns:1fr 1fr}.phase-track{grid-template-columns:1fr}.phase-track>b{transform:rotate(90deg)}.safe-loop{grid-template-columns:1fr 1fr}.formula{grid-template-columns:1fr}.formula b{text-align:center}}
  @media(max-width:560px){.problem-grid,.testing-grid,.docs-grid,.safe-loop{grid-template-columns:1fr}.speed-card>div{grid-template-columns:1fr}.level-actions{flex-direction:column}}
</style>
