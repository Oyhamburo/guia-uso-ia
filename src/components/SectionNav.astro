---
interface NavItem {
  label: string;
  href: string;
}

interface Props {
  items: NavItem[];
  label?: string;
}

const { items, label = "En esta página" } = Astro.props;
---

<nav class="section-nav wrap" aria-label={label}>
  <span>{label}</span>
  <div class="section-scroll" tabindex="0">
    <ul>
      {items.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
    </ul>
  </div>
</nav>

<style>
  .section-nav {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-block: 0.8rem 0;
  }

  .section-nav > span {
    flex: 0 0 auto;
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 850;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .section-scroll {
    overflow-x: auto;
    scrollbar-width: thin;
  }

  ul {
    display: flex;
    width: max-content;
    gap: 0.4rem;
    margin: 0;
    padding: 0.25rem;
    list-style: none;
  }

  a {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    padding: 0.45rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgb(255 253 247 / 72%);
    color: var(--ink);
    font-size: 0.84rem;
    font-weight: 780;
    text-decoration: none;
  }

  a:hover {
    border-color: var(--jungle);
    background: var(--white);
  }

  @media (max-width: 620px) {
    .section-nav { display: grid; }
  }
</style>
