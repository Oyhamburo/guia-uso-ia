---
interface Props {
  current?: "home" | "parte-1" | "juegos" | "parte-2" | "parte-3";
}

const { current = "home" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const href = (path: string) => `${base}${path.replace(/^\//, "")}`;
---

<header class="site-header">
  <nav class="top-nav wrap" aria-label="Navegación principal">
    <a class="home-link" href={`${href("")}#mapa`} aria-current={current === "home" ? "page" : undefined}>
      <span class="brand">
        <span class="brand-footprint" aria-hidden="true">◆</span>
        <span><strong>Expedición IA</strong><small>Aprender sin perder el criterio</small></span>
      </span>
      <span class="map-cta"><span aria-hidden="true">⌂</span> Mapa del recorrido</span>
    </a>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    border-bottom: 1px solid rgb(255 255 255 / 14%);
    background: rgb(23 44 58 / 94%);
    box-shadow: 0 6px 20px rgb(23 44 58 / 12%);
    backdrop-filter: blur(14px);
  }

  .top-nav {
    display: flex;
    align-items: center;
    min-height: 74px;
  }

  .home-link {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    color: white;
    text-decoration: none;
  }

  .home-link:hover .map-cta {
    border-color: #ffe1a0;
    background: rgb(245 189 67 / 16%);
    color: #fff4c4;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
  }

  .brand-footprint {
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    rotate: 45deg;
    border: 2px solid #ffe1a0;
    border-radius: 13px 18px 13px 18px;
    background: #f5bd43;
    color: var(--night);
    box-shadow: 3px 3px 0 #071720;
  }

  .brand > span:last-child {
    display: grid;
    line-height: 1.1;
  }

  .brand strong {
    font-family: var(--font-display);
    font-size: 1.05rem;
  }

  .brand small {
    margin-top: 0.2rem;
    color: #cadad4;
    font-size: 0.72rem;
  }

  .map-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    padding: 0.55rem 0.85rem;
    border: 1px solid rgb(255 255 255 / 22%);
    border-radius: 999px;
    color: #e8f0ed;
    font-size: 0.86rem;
    font-weight: 760;
    white-space: nowrap;
    transition: border-color 160ms ease, background 160ms ease, color 160ms ease;
  }

  .home-link:focus-visible {
    outline: 3px solid #ffe1a0;
    outline-offset: 4px;
  }

  @media (max-width: 760px) {
    .top-nav {
      min-height: 0;
      padding-block: 0.65rem;
    }

    .brand small {
      display: none;
    }

    .map-cta {
      padding-inline: 0.65rem;
      font-size: 0.78rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .map-cta { transition: none; }
  }
</style>
