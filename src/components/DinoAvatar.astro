---
interface Props {
  dino?: "cera" | "paco" | "vera" | "anky" | "bruna" | "roco";
  /** Backward-friendly alias used by page data. */
  name?: "cera" | "paco" | "vera" | "anky" | "bruna" | "roco";
  mood?: "neutral" | "thinking" | "alert" | "celebrating" | "explaining";
  label?: string;
  size?: "sm" | "md" | "lg" | "small" | "medium" | "large";
}

const { dino: dinoProp, name, mood: moodProp = "neutral", label, size: sizeProp = "md" } = Astro.props;
const dino = dinoProp ?? name ?? "cera";
const mood = moodProp === "explaining" ? "neutral" : moodProp;
const size = ({ small: "sm", medium: "md", large: "lg" } as const)[sizeProp as "small" | "medium" | "large"] ?? sizeProp;
const palette = {
  cera: { body: "#d99a1e", dark: "#8a5710", belly: "#ffe7a7" },
  paco: { body: "#2f7196", dark: "#17465f", belly: "#b9dfef" },
  vera: { body: "#c9573f", dark: "#7d2e22", belly: "#ffd0be" },
  anky: { body: "#3e8966", dark: "#1e5b42", belly: "#cce7d7" },
  bruna: { body: "#6941a5", dark: "#3e226b", belly: "#ded0f5" },
  roco: { body: "#176b55", dark: "#0c4637", belly: "#bce4cf" }
}[dino];

const eyeY = mood === "thinking" ? 76 : 74;
---

<div class:list={["dino-avatar", `size-${size}`, `mood-${mood}`]}>
  <svg
    viewBox="0 0 260 210"
    role={label ? "img" : undefined}
    aria-label={label}
    aria-hidden={label ? undefined : "true"}
  >
    <ellipse cx="132" cy="190" rx="91" ry="12" fill="rgb(23 44 58 / 12%)" />

    {dino === "bruna" ? (
      <g class="dino-body">
        <path d="M76 164c9-38 26-56 49-61 18-4 34 5 47 20l13-69c2-15 14-25 28-23 13 2 21 14 17 28l-19 81c-3 15-15 26-30 30-24 7-72 8-105-6Z" fill={palette.body} stroke={palette.dark} stroke-width="5" stroke-linejoin="round" />
        <path d="M209 38c11-3 22 2 26 11-12 5-23 4-32-4Z" fill={palette.belly} />
        <circle cx="217" cy="47" r="4" fill="#172c3a" />
        <path d="M70 158 30 142c-12-5-16-14-11-21 15 15 36 19 58 20Z" fill={palette.body} stroke={palette.dark} stroke-width="5" stroke-linejoin="round" />
        <path d="M101 160v31M157 160v31" stroke={palette.dark} stroke-width="12" stroke-linecap="round" />
      </g>
    ) : dino === "cera" ? (
      <g class="dino-body">
        <path d="M52 158c8-42 37-64 81-63 44 2 71 27 72 66-44 22-105 22-153-3Z" fill={palette.body} stroke={palette.dark} stroke-width="5" />
        <path d="m49 148-34-14c9-17 28-29 48-29" fill={palette.body} stroke={palette.dark} stroke-width="5" stroke-linejoin="round" />
        <path d="M160 106c24-26 64-23 80 1-7 28-28 46-58 49Z" fill={palette.belly} stroke={palette.dark} stroke-width="5" />
        <path d="m180 103 6-29 12 28m13 3 16-22 1 31" fill={palette.belly} stroke={palette.dark} stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
        <circle cx="211" cy={eyeY} r="5" fill="#172c3a" />
        <path d="M93 158v32m68-31v31" stroke={palette.dark} stroke-width="13" stroke-linecap="round" />
      </g>
    ) : dino === "paco" ? (
      <g class="dino-body">
        <path d="M53 160c7-43 39-67 85-64 41 2 66 27 70 65-48 20-109 21-155-1Z" fill={palette.body} stroke={palette.dark} stroke-width="5" />
        <path d="M188 109c9-31 32-48 52-39-4 30-18 49-41 58Z" fill={palette.body} stroke={palette.dark} stroke-width="5" stroke-linejoin="round" />
        <path d="M228 70c11-28-1-43-18-52 3 26-5 40-20 53Z" fill={palette.belly} stroke={palette.dark} stroke-width="5" />
        <circle cx="221" cy={eyeY} r="5" fill="#172c3a" />
        <path d="m56 147-39-13c11-19 29-28 48-28" fill={palette.body} stroke={palette.dark} stroke-width="5" />
        <path d="M91 160v30m68-30v30" stroke={palette.dark} stroke-width="13" stroke-linecap="round" />
      </g>
    ) : dino === "anky" ? (
      <g class="dino-body">
        <path d="M51 159c5-41 36-64 84-64 45 0 73 24 76 65-44 21-111 22-160-1Z" fill={palette.body} stroke={palette.dark} stroke-width="5" />
        <path d="M55 147 23 131 8 138l18 12-10 17 37-8" fill={palette.body} stroke={palette.dark} stroke-width="5" stroke-linejoin="round" />
        <path d="m80 106 10-21 12 18m16-8 12-23 12 23m17 4 13-21 10 28" fill={palette.belly} stroke={palette.dark} stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
        <circle cx="184" cy="124" r="5" fill="#172c3a" />
        <path d="M89 161v29m70-29v29" stroke={palette.dark} stroke-width="13" stroke-linecap="round" />
      </g>
    ) : dino === "vera" ? (
      <g class="dino-body">
        <path d="M60 158c10-39 36-61 75-62 37-1 61 23 66 63-42 19-98 20-141-1Z" fill={palette.body} stroke={palette.dark} stroke-width="5" />
        <path d="M179 111c9-29 36-43 62-27-8 29-29 45-55 47Z" fill={palette.body} stroke={palette.dark} stroke-width="5" />
        <circle cx="218" cy={eyeY + 14} r="5" fill="#172c3a" />
        <path d="m65 144-48-18c8-18 31-27 54-20" fill={palette.body} stroke={palette.dark} stroke-width="5" />
        <path d="M95 160v29m61-29 14 28" stroke={palette.dark} stroke-width="12" stroke-linecap="round" />
        <path d="m177 142 18 12m-24-2 18 12" stroke={palette.dark} stroke-width="6" stroke-linecap="round" />
      </g>
    ) : (
      <g class="dino-body">
        <path d="M65 160c5-42 26-68 63-70 38-2 64 24 69 71-38 18-92 20-132-1Z" fill={palette.body} stroke={palette.dark} stroke-width="5" />
        <path d="M166 103c17-31 49-35 75-14-7 29-29 44-58 42Z" fill={palette.body} stroke={palette.dark} stroke-width="5" />
        <circle cx="219" cy={eyeY + 13} r="5" fill="#172c3a" />
        <path d="m70 144-53-24c7-20 32-30 57-20" fill={palette.body} stroke={palette.dark} stroke-width="5" />
        <path d="M99 160v30m55-29 12 28" stroke={palette.dark} stroke-width="13" stroke-linecap="round" />
        <path d="m178 141 12 4m-14 7 12 4" stroke={palette.dark} stroke-width="7" stroke-linecap="round" />
      </g>
    )}

    {mood === "alert" && <path d="M229 40v-15m-10 19-10-11m30 11 10-11" stroke="#c9573f" stroke-width="5" stroke-linecap="round" />}
    {mood === "thinking" && <g fill="none" stroke="#6941a5" stroke-width="4"><circle cx="220" cy="26" r="5"/><circle cx="238" cy="16" r="9"/></g>}
    {mood === "celebrating" && <g fill="#d99a1e"><path d="m34 48 4 9 10 1-8 6 2 10-8-6-9 6 3-10-8-6 10-1Z"/><path d="m226 36 3 7 8 1-6 5 2 8-7-5-7 5 2-8-6-5 8-1Z"/></g>}
  </svg>
</div>

<style>
  .dino-avatar {
    display: grid;
    width: 100%;
    place-items: center;
  }

  .size-sm { max-width: 150px; }
  .size-md { max-width: 260px; }
  .size-lg { max-width: 390px; }

  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .dino-body {
    transform-origin: 50% 85%;
    animation: dino-breathe 3.8s ease-in-out infinite;
  }

  .mood-celebrating .dino-body {
    animation: dino-hop 1.2s ease-in-out infinite;
  }

  @keyframes dino-breathe {
    50% { transform: translateY(-2px) rotate(-0.4deg); }
  }

  @keyframes dino-hop {
    50% { transform: translateY(-7px) rotate(-1deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .dino-body { animation: none; }
  }
</style>
