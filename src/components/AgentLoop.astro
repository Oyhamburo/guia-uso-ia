---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<figure class:list={["agent-loop", { compact }]}>
  <figcaption>
    <span>El ciclo del agente</span>
    <strong>objetivo → propuesta → acción → evidencia → próxima decisión</strong>
  </figcaption>
  <div class="loop-track" aria-label="Ciclo de trabajo entre agente, modelo y herramientas">
    <div class="loop-node agent">
      <span class="node-icon" aria-hidden="true">◎</span>
      <b>Agente</b>
      <small>mantiene el objetivo</small>
    </div>
    <span class="arrow" aria-hidden="true">→</span>
    <div class="loop-node model">
      <span class="node-icon" aria-hidden="true">◇</span>
      <b>Modelo</b>
      <small>propone la próxima salida</small>
    </div>
    <span class="arrow" aria-hidden="true">→</span>
    <div class="loop-node tool">
      <span class="node-icon" aria-hidden="true">⚙</span>
      <b>Tool</b>
      <small>ejecuta una operación</small>
    </div>
    <span class="arrow" aria-hidden="true">→</span>
    <div class="loop-node result">
      <span class="node-icon" aria-hidden="true">✓</span>
      <b>Resultado</b>
      <small>vuelve como evidencia</small>
    </div>
    <span class="return-arrow" aria-hidden="true">↺</span>
  </div>
  <p class="harness-note"><b>Harness:</b> prepara contexto, expone tools, aplica permisos y conserva el estado del ciclo.</p>
</figure>

<style>
  .agent-loop {
    margin: 1.5rem 0;
    padding: clamp(1rem, 3vw, 1.75rem);
    border: 1px solid color-mix(in srgb, var(--violet, #6941a5) 28%, transparent);
    border-radius: 1.5rem;
    background: linear-gradient(145deg, color-mix(in srgb, #fff 88%, #ede9fe), color-mix(in srgb, #fff 92%, #dff5ee));
  }
  figcaption { display: grid; gap: .25rem; margin-bottom: 1.15rem; }
  figcaption span { color: var(--violet, #6941a5); font-size: .78rem; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; }
  figcaption strong { font-size: clamp(1rem, 2vw, 1.25rem); }
  .loop-track { position: relative; display: grid; grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr; gap: .55rem; align-items: center; }
  .loop-node { min-height: 8rem; display: grid; place-items: center; align-content: center; gap: .25rem; padding: 1rem .75rem; border: 1px solid rgba(32,48,43,.15); border-radius: 1.15rem; background: rgba(255,255,255,.8); text-align: center; }
  .loop-node.agent { border-color: rgba(105,65,165,.38); }
  .loop-node.model { border-color: rgba(47,113,150,.38); }
  .loop-node.tool { border-color: rgba(217,154,30,.48); }
  .loop-node.result { border-color: rgba(23,107,85,.38); }
  .node-icon { display: grid; place-items: center; width: 2.25rem; height: 2.25rem; border-radius: .75rem; background: #f4f0ff; color: var(--violet, #6941a5); font-size: 1.2rem; }
  .loop-node small { max-width: 14ch; color: var(--muted, #51605a); line-height: 1.3; }
  .arrow { color: var(--violet, #6941a5); font-size: 1.35rem; font-weight: 900; }
  .return-arrow { position: absolute; right: -.4rem; bottom: -1.1rem; color: var(--fern, #3e8966); font-size: 1.7rem; font-weight: 900; }
  .harness-note { margin: 1.25rem 0 0; padding: .8rem 1rem; border-radius: 1rem; background: rgba(105,65,165,.08); color: var(--muted, #51605a); }
  .harness-note b { color: var(--ink, #20302b); }
  .compact .loop-node { min-height: 6.5rem; }
  @media (max-width: 760px) {
    .loop-track { grid-template-columns: 1fr; }
    .arrow { transform: rotate(90deg); text-align: center; }
    .return-arrow { display: none; }
    .loop-node { min-height: auto; }
  }
</style>
