---
import DinoAvatar from "./DinoAvatar.astro";

interface Props {
  level?: string;
  eyebrow: string;
  title: string;
  intro: string;
  dino?: "cera" | "paco" | "vera" | "anky" | "bruna" | "roco";
  dinoLabel?: string;
  guide?: string;
  tone?: "field" | "sky" | "amber" | "fern" | "coral" | "technical";
  compact?: boolean;
}

const {
  eyebrow,
  title,
  intro,
  dino = "cera",
  dinoLabel,
  guide,
  tone = "field",
  compact = false
} = Astro.props;
---

<section class:list={["level-hero", `tone-${tone}`, { compact }]}>
  <div class="hero-copy">
    <span class="eyebrow">{eyebrow}</span>
    <h1>{title}</h1>
    <p>{intro}</p>
    <div class="hero-actions"><slot name="actions" /></div>
  </div>
  <div class="guide-wrap">
    <DinoAvatar dino={dino} label={dinoLabel} size={compact ? "md" : "lg"} />
    {guide && <p class="guide-bubble"><strong>{dinoLabel ?? "Tu guía"}:</strong> {guide}</p>}
  </div>
</section>

<style>
  .level-hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(260px, 0.88fr);
    min-height: min(680px, calc(100vh - 74px));
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4.5rem);
    padding: clamp(2rem, 5vw, 4.5rem);
    border: 1.5px solid var(--line);
    border-radius: var(--radius-xl);
    background:
      linear-gradient(145deg, rgb(255 253 247 / 94%), rgb(238 231 213 / 84%));
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .level-hero::before {
    position: absolute;
    inset: auto -4rem -8rem auto;
    width: 24rem;
    height: 24rem;
    border: 3rem solid rgb(23 107 85 / 8%);
    border-radius: 50%;
    content: "";
  }

  .tone-sky { background: linear-gradient(145deg, #f9fcfb, #dbeaf1); }
  .tone-amber { background: linear-gradient(145deg, #fffdf7, #f8e9b9); }
  .tone-fern { background: linear-gradient(145deg, #fbfdf9, #d8eadb); }
  .tone-coral { background: linear-gradient(145deg, #fffaf5, #f4ddd2); }
  .tone-technical {
    border-color: rgb(255 255 255 / 20%);
    background: radial-gradient(circle at 80% 20%, rgb(105 65 165 / 34%), transparent 18rem), var(--night);
    color: #f7f3e8;
  }
  .tone-technical .eyebrow { color: #f4c766; }
  .tone-technical .hero-copy > p { color: #cbd8d4; }

  .compact {
    min-height: 470px;
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1rem;
  }

  h1 { max-width: 12ch; }

  .hero-copy > p {
    max-width: 57ch;
    margin: 0;
    color: var(--muted);
    font-size: clamp(1.05rem, 2vw, 1.3rem);
  }

  .hero-actions:empty { display: none; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.7rem; }

  .guide-wrap {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
  }

  .guide-bubble {
    max-width: 28rem;
    margin: -0.35rem 0 0;
    padding: 0.8rem 1rem;
    border: 1.5px solid currentColor;
    border-radius: 18px 18px 18px 4px;
    background: var(--white);
    box-shadow: 3px 4px 0 rgb(32 48 43 / 85%);
    color: var(--ink);
    font-size: 0.94rem;
  }

  @media (max-width: 790px) {
    .level-hero {
      grid-template-columns: 1fr;
      min-height: 0;
      padding: 2rem 1.25rem;
    }

    .guide-wrap { grid-row: 1; }
    .guide-wrap :global(.dino-avatar) { max-width: 230px; }
    h1 { max-width: none; }
  }
</style>
