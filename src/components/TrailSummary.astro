---
import DinoAvatar from "./DinoAvatar.astro";

interface Props {
  title?: string;
  items: string[];
  dino?: "cera" | "paco" | "vera" | "anky" | "bruna" | "roco";
  previousHref?: string;
  previousLabel?: string;
  nextHref?: string;
  nextLabel?: string;
  mapHref?: string;
}

const {
  title = "Lo que te llevás en la mochila",
  items,
  dino = "vera",
  previousHref,
  previousLabel = "Volver",
  nextHref,
  nextLabel = "Seguir la expedición",
  mapHref
} = Astro.props;
---

<section class="trail-summary" aria-labelledby="trail-summary-title">
  <DinoAvatar dino={dino} mood="celebrating" size="sm" />
  <div>
    <span class="eyebrow">Resumen de campo</span>
    <h2 id="trail-summary-title">{title}</h2>
    <ul>
      {items.map((item) => <li><span aria-hidden="true">✓</span>{item}</li>)}
    </ul>
    <nav class="slide-nav" aria-label="Avanzar por la expedición">
      {previousHref && <a class="previous" href={previousHref}>← {previousLabel}</a>}
      {mapHref && <a class="map" href={mapHref}>Mapa de la expedición</a>}
      {nextHref && <a class="button" href={nextHref}>{nextLabel} →</a>}
    </nav>
  </div>
</section>

<style>
  .trail-summary {
    display: grid;
    grid-template-columns: 160px 1fr;
    align-items: center;
    gap: 1.5rem;
    padding: clamp(1.3rem, 3vw, 2.2rem);
    border: 2px solid var(--ink);
    border-radius: var(--radius-xl);
    background: #e6f1e9;
    box-shadow: 5px 6px 0 var(--ink);
  }

  h2 { margin-top: 0.4rem; font-size: clamp(1.8rem, 4vw, 3rem); }

  ul {
    display: grid;
    gap: 0.55rem;
    margin: 1.25rem 0 1.5rem;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: 28px 1fr;
    align-items: start;
    gap: 0.4rem;
  }

  li span {
    display: grid;
    width: 24px;
    height: 24px;
    place-items: center;
    border-radius: 50%;
    background: var(--jungle);
    color: white;
    font-weight: 900;
  }

  .slide-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem;
  }

  .slide-nav a { min-height: 44px; display: inline-flex; align-items: center; }
  .slide-nav .previous, .slide-nav .map { color: var(--jungle); font-weight: 800; }
  .slide-nav .map { margin-inline: auto; font-size: 0.9rem; }

  @media (max-width: 620px) {
    .trail-summary { grid-template-columns: 1fr; }
    .trail-summary :global(.dino-avatar) { max-width: 125px; justify-self: center; }
    .slide-nav { align-items: stretch; }
    .slide-nav a { width: 100%; justify-content: center; }
    .slide-nav .map { order: 3; }
  }
</style>
